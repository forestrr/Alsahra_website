---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactSection from '../components/ContactSection.astro';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout
  title="Contact Us & Request a Quote | Al Sahra Tents & Sheds Fix UAE"
  description="Get in touch with Al Sahra Tents & Sheds Fix in Sharjah Al Dhaid. Request a formal quotation or schedule a site survey for tensile shades, car parking sheds, and tents across the UAE."
>
  <Header />
  
  <main>
    <!-- Full-Bleed Monolithic Contact Dashboard -->
    <ContactSection />

    <!-- Client References Marquee -->
    <div class="bg-navy-darker relative z-10 border-t border-white/5">
      <ClientsMarquee />
    </div>
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../scripts/animations';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initWebsiteAnimations());
  } else {
    initWebsiteAnimations();
  }
</script>
