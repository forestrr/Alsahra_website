---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout
  title="About Us & Industries Served | Al Sahra Tents & Sheds Fix UAE"
  description="Learn about Al Sahra Tents & Sheds Fix — Sharjah Al Dhaid manufacturer of architectural tensile structures, custom majlis tents, and structural steel sheds across UAE."
>
  <Header />
  
  <main>
    <!-- Page Hero Banner (Editorial Design) -->
    <section class="bg-navy-darker py-24 md:py-32 px-6 sm:px-10 lg:px-16 border-b border-navy-mid relative overflow-hidden text-canvas">
      <!-- Deep ambient glows -->
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-primary/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gold-accent/10 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-end">
          
          <!-- Left: Massive Typography -->
          <div class="lg:col-span-8">
            <div class="inline-flex items-center gap-3 mb-8">
              <span class="w-12 h-[1px] bg-gold-accent"></span>
              <span class="text-gold-accent font-mono text-sm uppercase tracking-[0.2em] font-semibold">Corporate Overview</span>
            </div>
            
            <h1 class="font-display font-black text-5xl md:text-6xl lg:text-[80px] leading-[1.05] tracking-tight text-white mb-8 max-w-4xl drop-shadow-lg">
              Engineering <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-300">Excellence</span> & Purpose-Built Structures.
            </h1>
            
            <p class="font-body text-ink-secondary text-lg md:text-xl max-w-2xl leading-relaxed border-l-4 border-navy-mid pl-6">
              From our Sharjah Al Dhaid manufacturing facility to landmark projects across the 7 Emirates, we deliver certified architectural tensile shades, custom tents, and turnkey steel fabrication.
            </p>
          </div>

          <!-- Right: Industrial Stats Block -->
          <div class="lg:col-span-4 lg:justify-self-end w-full">
            <div class="bg-navy-darker/50 backdrop-blur-md border border-white/10 rounded-[32px] p-8 shadow-2xl relative overflow-hidden group">
              <!-- Animated gradient border effect inside -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <div class="flex flex-col gap-8 relative z-10">
                <div>
                  <div class="text-4xl font-display font-bold text-white mb-1">500<span class="text-primary">+</span></div>
                  <div class="text-xs font-mono uppercase tracking-widest text-ink-secondary">UAE Projects Delivered</div>
                </div>
                <div class="w-full h-[1px] bg-white/10"></div>
                <div>
                  <div class="text-4xl font-display font-bold text-white mb-1">100<span class="text-primary">%</span></div>
                  <div class="text-xs font-mono uppercase tracking-widest text-ink-secondary">In-House Manufacturing</div>
                </div>
                <div class="w-full h-[1px] bg-white/10"></div>
                <div>
                  <div class="text-4xl font-display font-bold text-white mb-1">10<span class="text-primary">+</span></div>
                  <div class="text-xs font-mono uppercase tracking-widest text-ink-secondary">Years of Expertise</div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- About Section & What We Do -->
    <About />

    <!-- Industries We Serve Section -->
    <IndustriesSection />

    <!-- Client References Marquee -->
    <ClientsMarquee />

    <!-- Uniform Contact CTA Banner -->
    <ContactCTA />
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../scripts/animations';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initWebsiteAnimations());
  } else {
    initWebsiteAnimations();
  }
</script>
