---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import ClientLogoStrip from '../components/ClientLogoStrip.astro';
import ExecutionProcess from '../components/ExecutionProcess.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout
  title="Al Sahra Tents & Sheds Fix | Tents, Tensile Shades & Steel Fabrication UAE"
  description="Al Sahra Tents & Sheds Fix designs, manufactures and installs architectural tensile shade structures, car parking shades, custom majlis tents, and structural steel sheds in Sharjah Al Dhaid, UAE."
>
  <Header />
  <main>
    <Hero />
    <StatsBar />
    <ClientLogoStrip />
    <ExecutionProcess />
    <ServicesGrid />
    <HowWeWork />

    <!-- Discovery Gateway Cards to Dedicated Projects & Trades Pages -->
    <section class="bg-cream py-24 px-6 sm:px-10 lg:px-16 border-t border-hairline relative">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-6 md:gap-10">
        
        <!-- Projects Card -->
        <a 
          href="/projects" 
          class="group relative bg-navy-darker h-[450px] sm:h-[500px] rounded-[32px] shadow-lg hover:shadow-2xl transition-all duration-500 flex flex-col justify-end overflow-hidden"
          data-reveal="fade-up"
        >
          <!-- Background Image -->
          <img src="/images/gallery_tensile_overview_1.png" alt="Project Gallery" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" loading="lazy" />
          
          <!-- Gradient Overlays -->
          <div class="absolute inset-0 bg-gradient-to-t from-navy-darker/95 via-navy-darker/50 to-transparent transition-opacity duration-500 group-hover:opacity-90"></div>
          <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 mix-blend-overlay"></div>
          
          <!-- Content -->
          <div class="relative z-10 p-8 sm:p-10 transform transition-transform duration-500 group-hover:-translate-y-2">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-[10px] font-mono font-semibold uppercase tracking-wider text-emerald-400 mb-4 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              UAE Installation Portfolio
            </span>
            <h3 class="font-display font-bold text-3xl sm:text-4xl text-white mb-3 drop-shadow-md group-hover:text-emerald-400 transition-colors duration-300">
              Explore Our Project Gallery
            </h3>
            <p class="font-body text-white/80 text-sm sm:text-base leading-relaxed mb-6 max-w-sm drop-shadow-sm">
              Browse 500+ completed tensile shade structures, luxury car parking shades, cantilever roofs, and custom tents across the 7 Emirates.
            </p>
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-400 text-navy-darker shadow-lg group-hover:bg-white group-hover:scale-110 transition-all duration-300">
              <svg class="w-5 h-5 -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        </a>

        <!-- Trades Card (Asymmetrically Offset) -->
        <a 
          href="/trades" 
          class="group relative bg-navy-darker h-[450px] sm:h-[500px] rounded-[32px] shadow-lg hover:shadow-2xl transition-all duration-500 flex flex-col justify-end overflow-hidden md:mt-16"
          data-reveal="fade-up"
          data-reveal-delay="0.15"
        >
          <!-- Background Image -->
          <img src="/images/inhouse_factory.png" alt="Industrial Trades" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" loading="lazy" />
          
          <!-- Gradient Overlays -->
          <div class="absolute inset-0 bg-gradient-to-t from-navy-darker/95 via-navy-darker/50 to-transparent transition-opacity duration-500 group-hover:opacity-90"></div>
          <div class="absolute inset-0 bg-gold-accent/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 mix-blend-overlay"></div>
          
          <!-- Content -->
          <div class="relative z-10 p-8 sm:p-10 transform transition-transform duration-500 group-hover:-translate-y-2">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-[10px] font-mono font-semibold uppercase tracking-wider text-gold-accent mb-4 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-gold-accent animate-pulse"></span>
              Sharjah Al Dhaid Workshop
            </span>
            <h3 class="font-display font-bold text-3xl sm:text-4xl text-white mb-3 drop-shadow-md group-hover:text-gold-accent transition-colors duration-300">
              Our Trades & Industrial Panels
            </h3>
            <p class="font-body text-white/80 text-sm sm:text-base leading-relaxed mb-6 max-w-sm drop-shadow-sm">
              Direct-manufacturer steel fabrication, CNC cutting, certified welding, insulated sandwich panels, and corrugated sheet distribution.
            </p>
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gold-accent text-navy-darker shadow-lg group-hover:bg-white group-hover:scale-110 transition-all duration-300">
              <svg class="w-5 h-5 -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        </a>

      </div>
    </section>

    <ClientsMarquee />
    <ContactCTA />
  </main>
  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../scripts/animations';

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initWebsiteAnimations();
    });
  } else {
    initWebsiteAnimations();
  }
</script>
