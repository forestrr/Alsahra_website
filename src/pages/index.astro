---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import About from '../components/About.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ProjectsGallery from '../components/ProjectsGallery';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <StatsBar />
    <About />
    <ServicesGrid />
    <HowWeWork />
    <ProjectsGallery client:load />
    <ClientsMarquee />
    <ContactSection />
  </main>
  <Footer />
</Layout>
