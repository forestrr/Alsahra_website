---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import ClientsMarquee from '../../../components/ClientsMarquee.astro';
import Footer from '../../../components/Footer.astro';
import FloatingActions from '../../../components/FloatingActions.astro';
import { services, type ServiceCategory, type ServiceSubItem } from '../../../data/services';

export async function getStaticPaths() {
  const paths: { params: { slug: string; sub: string }; props: { category: ServiceCategory; subItem: ServiceSubItem } }[] = [];

  for (const category of services) {
    for (const subItem of category.subItems) {
      if (subItem.hasDedicatedPage) {
        paths.push({
          params: { slug: category.slug, sub: subItem.slug },
          props: { category, subItem }
        });
      }
    }
  }

  return paths;
}

interface Props {
  category: ServiceCategory;
  subItem: ServiceSubItem;
}

const { category, subItem } = Astro.props;

// Sibling sub-items for cross-nav
const siblingItems = category.subItems.filter(s => s.slug !== subItem.slug);
---

<Layout
  title={`${subItem.name} in UAE — ${category.name} | Al Sahra Tents`}
  description={`${subItem.description} Part of our ${category.name} range — engineered and installed by Al Sahra across Sharjah, Dubai, Abu Dhabi, and the UAE.`}
>
  {subItem.faqs && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": subItem.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    })} />
  )}
  <Header />

  <main>
    <!-- ========================================================================= -->
    <!-- 1. HERO BANNER                                                            -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker relative overflow-hidden text-canvas pt-24 pb-32 lg:pt-32 lg:pb-40 px-6 sm:px-10 lg:px-16 border-b border-navy-mid">
      <!-- Subtle ambient glows -->
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[140px] pointer-events-none mix-blend-screen"></div>
      <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-gold-accent/5 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left: Copy (7 cols) -->
        <div class="lg:col-span-7" data-reveal="fade-up">
          <div class="flex items-center gap-4 mb-8" data-reveal="fade-right">
            <div class="h-[1px] w-8 sm:w-16 bg-gold-accent relative">
              <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-gold-accent rotate-45 shadow-[0_0_10px_rgba(250,204,21,0.8)]"></div>
            </div>
            <span class="font-mono text-[10px] sm:text-xs text-gold-accent uppercase tracking-[0.3em] font-bold drop-shadow-md">
              <a href={`/services/${category.slug}`} class="hover:text-canvas transition-colors">{category.name}</a> <span class="mx-2 opacity-50">/</span> {subItem.name}
            </span>
          </div>

          <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl tracking-tight text-white mb-6 leading-tight drop-shadow-lg">
            {subItem.name}
          </h1>

          <p class="font-body text-canvas/80 text-lg sm:text-xl max-w-2xl mb-10 leading-relaxed">
            {subItem.description}
          </p>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
            <a 
              href="/contact" 
              class="btn-live-primary btn-shimmer w-full sm:w-auto font-body font-bold text-sm px-8 py-4 rounded-xl flex items-center justify-center gap-2 shadow-[0_10px_30px_rgba(30,58,138,0.4)] hover:-translate-y-1 transition-transform duration-300"
            >
              <span>Request Specifications</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

            <a 
              href={`https://wa.me/971505077179?text=Hello%20Al%20Sahra,%20I%20am%20interested%20in%20${encodeURIComponent(subItem.name)}.`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto bg-navy-card hover:bg-navy-mid text-white font-body font-bold text-sm px-8 py-4 rounded-xl border border-navy-border hover:border-gold-accent transition-all duration-300 flex items-center justify-center gap-2 shadow-2xl hover:-translate-y-1"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"></span>
              <span>Discuss Project</span>
            </a>
          </div>
        </div>

        <!-- Right: Image Showcase (5 cols) -->
        <div class="lg:col-span-5 relative" data-reveal="fade-up" data-reveal-delay="0.1">
          <!-- Decorative frame behind image -->
          <div class="absolute -inset-4 bg-gradient-to-br from-primary/30 to-gold-accent/20 rounded-[2.5rem] transform rotate-3 blur-md opacity-70"></div>
          
          <div class="relative rounded-[2rem] overflow-hidden border-4 border-navy-mid shadow-[0_20px_50px_rgba(0,0,0,0.5)] bg-navy-darker group aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5]">
            {subItem.images && subItem.images.length > 0 ? (
              subItem.images.map((img, index) => (
                <img 
                  src={img} 
                  alt={`${subItem.name} installation by Al Sahra`} 
                  class={`absolute inset-0 w-full h-full object-cover ${subItem.imagePosition || 'object-center'} transition-opacity duration-1000 ${index === 0 ? 'opacity-100 z-0' : 'opacity-0 -z-10'}`}
                  data-hero-slide
                  loading={index === 0 ? "eager" : "lazy"}
                />
              ))
            ) : (
              <img 
                src={subItem.image || category.heroImage} 
                alt={subItem.name} 
                class={`absolute inset-0 w-full h-full object-cover ${subItem.imagePosition || 'object-center'} transition-transform duration-1000 group-hover:scale-110`}
                loading="eager"
              />
            )}
            <!-- Inner shadow gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-darker/80 via-transparent to-transparent pointer-events-none z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <script>
      function initHeroSlider() {
        const slides = document.querySelectorAll('[data-hero-slide]');
        if (slides.length <= 1) return;
        
        let currentSlide = 0;
        const interval = setInterval(() => {
          slides[currentSlide].classList.remove('opacity-100', 'z-0');
          slides[currentSlide].classList.add('opacity-0', '-z-10');
          
          currentSlide = (currentSlide + 1) % slides.length;
          
          slides[currentSlide].classList.remove('opacity-0', '-z-10');
          slides[currentSlide].classList.add('opacity-100', 'z-0');
        }, 3000); // Crossfade every 3 seconds

        // Cleanup on unmount if view transitions are used
        document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
      }
      
      // Initialize on load and on astro page transition
      document.addEventListener('astro:page-load', initHeroSlider);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroSlider);
      } else {
        initHeroSlider();
      }
    </script>

    <!-- ========================================================================= -->
    <!-- 2. DETAILED CONTENT                                                       -->
    <!-- ========================================================================= -->
    <section class="bg-cream py-24 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-4xl mx-auto text-center" data-reveal="fade-up">
        <span class="font-mono text-primary text-xs uppercase tracking-[0.2em] font-semibold block mb-6">
          System Overview
        </span>
        <h2 class="font-display text-3xl sm:text-4xl text-ink font-bold tracking-tight mb-8">
          Engineered for UAE Conditions
        </h2>

        <div class="space-y-6 font-body text-ink-soft text-lg leading-relaxed mb-12">
          <p>{subItem.description}</p>
          <p>
            Engineered, manufactured, and professionally installed by Al Sahra Tents & Sheds Fix from our Sharjah Al Dhaid facility. 
            We provide full turnkey project delivery including site survey, structural engineering, fabrication, and on-site installation 
            across all 7 Emirates of the UAE.
          </p>
          <p>
            As part of our <a href={`/services/${category.slug}`} class="text-primary font-semibold hover:underline transition-colors">{category.name}</a> division, 
            this solution is backed by our full manufacturing capability and complies with UAE municipal and Civil Defense engineering codes.
          </p>
        </div>

        <!-- Feature Highlights (Minimalist) -->
        <div class="border-t border-hairline pt-8 max-w-2xl mx-auto text-left">
          <ul class="grid sm:grid-cols-2 gap-y-4 gap-x-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm font-body text-ink-soft">In-house fabrication — Sharjah</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm font-body text-ink-soft">Turnkey installation (All Emirates)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm font-body text-ink-soft">UAE Civil Defense compliant</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm font-body text-ink-soft">Free site survey & quotation</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2A. IMAGE GALLERY (only renders if subItem.images exists)                 -->
    <!-- ========================================================================= -->
    {subItem.images && subItem.images.length > 0 && (
      <section class="bg-navy-darker py-24 px-6 sm:px-10 lg:px-16 border-b border-navy-mid relative overflow-hidden">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16" data-reveal="fade-up">
            <span class="font-mono text-gold-accent text-xs uppercase tracking-[0.2em] font-semibold block mb-4">
              Project Gallery
            </span>
            <h2 class="font-display text-3xl sm:text-4xl text-canvas font-bold tracking-tight">
              Recent Installations
            </h2>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 lg:gap-6">
            {subItem.images.map((img, i) => (
              <div 
                class="group relative aspect-[4/3] rounded-2xl overflow-hidden border border-navy-mid/50 bg-navy-card shadow-lg"
                data-reveal="scale-up" 
                data-reveal-delay={i * 0.1}
              >
                <img 
                  src={img} 
                  alt={`${subItem.name} installation by Al Sahra`}
                  class={`w-full h-full object-cover ${subItem.imagePosition || 'object-center'} transition-transform duration-700 group-hover:scale-110 opacity-90 group-hover:opacity-100`}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-darker/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ========================================================================= -->
    <!-- 2B. MATERIAL BREAKDOWN (only renders if subItem.materials exists)        -->
    <!-- ========================================================================= -->
    {subItem.materials && (
      <section class="bg-canvas py-24 px-6 sm:px-10 lg:px-16 border-b border-hairline">
        <div class="max-w-7xl mx-auto">
          <div class="grid lg:grid-cols-4 gap-12 lg:gap-16 items-start">
            
            <div class="lg:col-span-1" data-reveal="fade-up">
              <span class="font-mono text-primary text-xs uppercase tracking-[0.2em] font-semibold block mb-4">
                Membranes
              </span>
              <h2 class="font-display text-2xl sm:text-3xl text-ink font-bold tracking-tight">
                Material<br/>Options
              </h2>
            </div>

            <div class="lg:col-span-3" data-reveal="fade-up" data-reveal-delay="0.1">
              <!-- Sleek Material List -->
              <div class="border-t border-hairline divide-y divide-hairline mb-20">
                {subItem.materials.map((mat) => (
                  <div class="py-8 grid sm:grid-cols-3 gap-6 sm:gap-10">
                    <div class="sm:col-span-1">
                      <h3 class="font-display font-bold text-xl text-ink">{mat.name}</h3>
                    </div>
                    <div class="sm:col-span-2 space-y-6">
                      <p class="font-body text-ink-soft text-base leading-relaxed">{mat.summary}</p>
                      
                      <!-- SEO-Optimized Semantic List -->
                      <div class="pt-2">
                        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-muted block mb-4">Ideal Applications</span>
                        <ul class="flex flex-wrap gap-2.5">
                          {mat.whereUsed.map((use) => (
                            <li class="inline-flex items-center gap-2 bg-cream border border-hairline px-3.5 py-1.5 text-xs font-body text-ink-soft shadow-sm">
                              <svg class="w-3 h-3 text-gold-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                              <span>{use}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Sleek Spec Table -->
              {subItem.comparisonTable && (
                <div>
                  <h3 class="font-mono text-xs uppercase tracking-[0.2em] font-semibold block mb-6 text-ink">
                    Technical Specifications
                  </h3>
                  <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left font-body">
                      <thead>
                        <tr class="border-b border-ink/20">
                          <th class="py-4 pr-6 font-display font-semibold text-ink text-base">Property</th>
                          <th class="py-4 px-6 font-display font-semibold text-ink text-base">PTFE</th>
                          <th class="py-4 px-6 font-display font-semibold text-ink text-base">PVC</th>
                          <th class="py-4 px-6 font-display font-semibold text-ink text-base">HDPE</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-hairline">
                        {subItem.comparisonTable.map((row) => (
                          <tr class="hover:bg-cream/50 transition-colors">
                            <td class="py-4 pr-6 font-semibold text-ink whitespace-nowrap">{row.property}</td>
                            <td class="py-4 px-6 text-ink-soft">{row.ptfe}</td>
                            <td class="py-4 px-6 text-ink-soft">{row.pvc}</td>
                            <td class="py-4 px-6 text-ink-soft">{row.hdpe}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>

          </div>
        </div>
      </section>
    )}

    <!-- ========================================================================= -->
    <!-- 2C. FAQ (only renders if subItem.faqs exists)                            -->
    <!-- ========================================================================= -->
    {subItem.faqs && (
      <section class="bg-cream py-24 px-6 sm:px-10 lg:px-16 border-b border-hairline">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <span class="font-mono text-primary text-xs uppercase tracking-[0.2em] font-semibold block mb-4">
              Knowledge Base
            </span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink font-bold tracking-tight">
              Frequently Asked Questions
            </h2>
          </div>
          
          <div class="divide-y divide-hairline border-y border-hairline">
            {subItem.faqs.map((faq) => (
              <details class="group py-6 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                <summary class="flex items-center justify-between font-display font-semibold text-lg text-ink list-none">
                  <span>{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-45 text-gold-accent">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                  </span>
                </summary>
                <div class="mt-4 font-body text-ink-soft text-base leading-relaxed pr-8">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ========================================================================= -->
    <!-- 3. RELATED SOLUTIONS (SIBLINGS)                                           -->
    <!-- ========================================================================= -->
    <section class="bg-navy-canvas py-16 px-6 sm:px-10 lg:px-16 border-b border-navy-mid text-canvas">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h3 class="font-display font-bold text-xl text-canvas">
            More in {category.name}
          </h3>
          <a href={`/services/${category.slug}`} class="text-xs font-mono text-gold-accent hover:text-canvas transition-colors">
            View all {category.name} →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {siblingItems.slice(0, 6).map(sibling => (
            <div class="bg-navy-card p-5 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 group">
              <span class="font-mono text-[10px] text-gold-accent uppercase tracking-wider block mb-2">{category.name}</span>
              <h4 class="font-body font-semibold text-sm text-canvas group-hover:text-gold-accent transition-colors mb-2">
                {sibling.name}
              </h4>
              <p class="text-xs text-ink-secondary leading-relaxed mb-3 line-clamp-2">{sibling.description}</p>
              {sibling.hasDedicatedPage ? (
                <a 
                  href={`/services/${category.slug}/${sibling.slug}`}
                  class="text-[11px] font-semibold text-primary hover:text-canvas transition-colors inline-flex items-center gap-1"
                >
                  Learn more →
                </a>
              ) : (
                <a 
                  href="/contact"
                  class="text-[11px] font-semibold text-gold-accent hover:text-canvas transition-colors inline-flex items-center gap-1"
                >
                  Request a quote →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. CONSULTATION & FOOTER                                                  -->
    <!-- ========================================================================= -->
    <ContactCTA />
    <ClientsMarquee />
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../../../scripts/animations';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initWebsiteAnimations());
  } else {
    initWebsiteAnimations();
  }
</script>
