---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ClientsMarquee from '../../components/ClientsMarquee.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { services, type ServiceCategory } from '../../data/services';

export async function getStaticPaths() {
  return services.map(category => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

interface Props {
  category: ServiceCategory;
}

const { category } = Astro.props;

// Other categories for cross-navigation
const otherCategories = services.filter(c => c.slug !== category.slug);
---

<Layout
  title={category.metaTitle}
  description={category.metaDescription}
>
  <Header />

  <main>
    <!-- ========================================================================= -->
    <!-- 1. HERO BANNER                                                            -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker py-20 md:py-24 px-6 sm:px-10 lg:px-16 border-b border-navy-mid relative overflow-hidden text-canvas">
      <!-- Subtle ambient glows -->
      <div class="absolute top-1/2 left-1/4 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-gold-accent/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10 text-center">
        <!-- Category Pill -->
        <div class="inline-flex items-center gap-2 bg-navy-card/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10 text-gold-accent font-mono text-xs uppercase tracking-wider mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{category.subItems.length} Specialized Solutions • UAE Wide</span>
        </div>

        <!-- H1 Title -->
        <h1 class="font-display font-semibold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-canvas mb-4">
          {category.name}
        </h1>

        <!-- Intro -->
        <p class="font-body text-ink-secondary text-base sm:text-lg max-w-3xl mx-auto mb-8 leading-relaxed">
          {category.intro}
        </p>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a 
            href="/contact" 
            class="btn-live-primary btn-shimmer w-full sm:w-auto font-body font-semibold text-xs sm:text-sm px-6 py-3 rounded-xl flex items-center justify-center gap-2"
          >
            <span>Request Quotation & Site Survey</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <a 
            href={`https://wa.me/971505077179?text=Hello%20Al%20Sahra,%20I%20am%20interested%20in%20a%20quotation%20for%20${encodeURIComponent(category.name)}.`}
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto bg-navy-card hover:bg-navy-mid text-canvas font-body font-semibold text-xs sm:text-sm px-6 py-3 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 flex items-center justify-center gap-2 shadow-sm"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>WhatsApp Fast Support</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. HERO IMAGE + OVERVIEW                                                  -->
    <!-- ========================================================================= -->
    <section class="bg-cream py-20 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Copy (7 cols) -->
        <div class="lg:col-span-7" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Service Overview
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-ink font-bold tracking-tight mb-6">
            What We Offer
          </h2>

          <p class="font-body text-ink-soft text-sm sm:text-base leading-relaxed mb-8">
            {category.intro}
          </p>

          <!-- Quick stats box -->
          <div class="bg-sand p-6 sm:p-7 rounded-2xl border border-hairline shadow-sm">
            <h3 class="font-mono text-xs uppercase tracking-wider text-ink font-bold mb-3">
              Solutions in this category:
            </h3>
            <ul class="grid sm:grid-cols-2 gap-2.5">
              {category.subItems.map(sub => (
                <li class="flex items-center gap-2 text-xs sm:text-sm font-body text-ink-soft">
                  <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                  <span>{sub.name}</span>
                </li>
              ))}

            </ul>
          </div>
        </div>

        <!-- Right Column: Hero Image (5 cols) -->
        <div class="lg:col-span-5" data-reveal="scale-up" data-reveal-delay="0.1">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-canvas aspect-[4/3] bg-navy-darker group">
            <img 
              src={category.heroImage} 
              alt={`${category.name} — Al Sahra UAE`} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 [image-rendering:-webkit-optimize-contrast]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. SUB-ITEMS SECTIONS (each as H2/H3 on-page section)                    -->
    <!-- ========================================================================= -->
    <section class="bg-sand-soft py-20 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Our Solutions
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-ink font-bold tracking-tight mb-4">
            {category.name} — Products & Solutions
          </h2>
          <p class="font-body text-ink-soft text-sm sm:text-base">
            Explore the full range of solutions available within this service category, each engineered and installed by our team across the UAE.
          </p>
        </div>

        <div class={`grid gap-6 sm:gap-8 ${category.subItems.length <= 4 ? 'md:grid-cols-2' : category.subItems.length <= 6 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'}`}>
          {category.subItems.map((sub, idx) => (
            <div 
              class="bg-canvas p-7 rounded-2xl border border-hairline shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1"
              data-reveal="fade-up"
              data-reveal-delay={String((idx % 4) * 0.08)}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs text-primary font-bold uppercase tracking-wider">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <span class="w-2 h-2 rounded-full bg-gold-accent"></span>
                </div>

                <!-- Solution Image (or Placeholder) -->
                {sub.image ? (
                  <div class="mb-5 rounded-xl overflow-hidden aspect-[16/10] bg-sand relative shadow-sm">
                    <img 
                      src={sub.image} 
                      alt={sub.name} 
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy" 
                    />
                  </div>
                ) : (
                  <div class="mb-5 rounded-xl aspect-[16/10] bg-sand-soft border border-dashed border-hairline flex flex-col items-center justify-center relative group-hover:border-primary/40 transition-colors shadow-sm">
                    <svg class="w-6 h-6 text-ink-muted/50 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="font-mono text-[9px] text-ink-muted uppercase tracking-[0.2em]">Photo Pending</span>
                  </div>
                )}

                <h3 class="font-display font-bold text-xl text-ink mb-3 group-hover:text-primary transition-colors">
                  {sub.name}
                </h3>
                <p class="font-body text-ink font-semibold text-sm leading-relaxed mb-2">
                  {sub.description}
                </p>
                {sub.details && (
                  <p class="font-body text-ink-soft text-xs sm:text-sm leading-relaxed mb-5">
                    {sub.details}
                  </p>
                )}
              </div>

              <div class="pt-5 border-t border-hairline/80">
                <div class="mb-3">
                  <span class="text-[10px] font-mono bg-sand text-ink-muted px-2 py-0.5 rounded border border-hairline">
                    {sub.keyword}
                  </span>
                </div>

                {sub.hasDedicatedPage ? (
                  <a 
                    href={`/services/${category.slug}/${sub.slug}`}
                    class="flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary-dark transition-colors"
                  >
                    <span>Learn more</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href="/contact"
                    class="flex items-center gap-1.5 text-xs font-semibold text-gold-accent hover:text-ink transition-colors"
                  >
                    <span>Request a quote</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. EXPLORE OTHER CATEGORIES                                               -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker py-16 px-6 sm:px-10 lg:px-16 border-b border-navy-mid">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h3 class="font-display font-bold text-xl text-canvas">Explore Other Services</h3>
          <a href="/#services" class="text-xs font-mono text-gold-accent hover:text-canvas transition-colors">
            View All 9 Services →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {otherCategories.slice(0, 4).map(other => (
            <a 
              href={`/services/${other.slug}`}
              class="bg-navy-card p-4 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 flex items-center gap-3.5 group"
            >
              <img 
                src={other.heroImage} 
                alt={other.name} 
                class="w-14 h-14 rounded-lg object-cover shrink-0 bg-navy-darker"
                loading="lazy"
              />
              <div>
                <span class="font-mono text-[9.5px] text-gold-accent block">{other.subItems.length} Solutions</span>
                <span class="font-body font-semibold text-xs text-canvas group-hover:text-gold-accent transition-colors leading-tight line-clamp-1 block">
                  {other.name}
                </span>
                <span class="text-[10px] text-ink-muted group-hover:text-ink-secondary transition-colors">View details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 5. CONSULTATION BANNER & CLIENT REVIEWS                                   -->
    <!-- ========================================================================= -->
    <ContactCTA />
    <ClientsMarquee />
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../../scripts/animations';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initWebsiteAnimations());
  } else {
    initWebsiteAnimations();
  }
</script>
