---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ClientsMarquee from '../../components/ClientsMarquee.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { featuredServices, type ServiceItem } from '../../data/services';

export async function getStaticPaths() {
  return featuredServices.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

// Other services for quick cross-navigation
const otherServices = featuredServices.filter(s => s.slug !== service.slug);
---

<Layout
  title={`${service.title} in UAE | Al Sahra Tents & Sheds Fix`}
  description={`${service.description} Engineered, manufactured, and installed by Al Sahra across Sharjah, Dubai, Abu Dhabi, and the UAE.`}
>
  <Header />

  <main>
    <!-- ========================================================================= -->
    <!-- 1. UNIFORM HERO BANNER (MATCHES ALL OTHER PAGES)                          -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker py-20 md:py-24 px-6 sm:px-10 lg:px-16 border-b border-navy-mid relative overflow-hidden text-canvas">
      <!-- Subtle ambient glows -->
      <div class="absolute top-1/2 left-1/4 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-gold-accent/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10 text-center">
        <!-- Category Pill -->
        <div class="inline-flex items-center gap-2 bg-navy-card/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10 text-gold-accent font-mono text-xs uppercase tracking-wider mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{service.category} • UAE Certified Engineering</span>
        </div>

        <!-- Main Title -->
        <h1 class="font-display font-semibold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-canvas mb-4">
          {service.title}
        </h1>

        <!-- Subheading -->
        <p class="font-body text-ink-secondary text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
          {service.heroTagline}
        </p>

        <!-- 3 Quick Metrics -->
        <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-mono text-ink-secondary pt-6 border-t border-navy-mid/60 max-w-2xl mx-auto mb-8">
          {service.quickMetrics.map((metric, idx) => (
            <>
              {idx > 0 && <div class="w-1 h-1 rounded-full bg-navy-mid hidden sm:block"></div>}
              <div>
                <span class="text-canvas font-bold text-base block sm:inline mr-1">{metric.value}</span>
                <span>{metric.label}</span>
              </div>
            </>
          ))}
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a 
            href="/contact" 
            class="btn-live-primary btn-shimmer w-full sm:w-auto font-body font-semibold text-xs sm:text-sm px-6 py-3 rounded-xl flex items-center justify-center gap-2"
          >
            <span>Request Quotation & Site Survey</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <a 
            href={`https://wa.me/971505077179?text=Hello%20Al%20Sahra,%20I%20am%20interested%20in%20a%20quotation%20for%20${encodeURIComponent(service.title)}.`}
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto bg-navy-card hover:bg-navy-mid text-canvas font-body font-semibold text-xs sm:text-sm px-6 py-3 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 flex items-center justify-center gap-2 shadow-sm"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>WhatsApp Fast Support</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. IN-DEPTH ENGINEERING OVERVIEW & IMAGE SHOWCASE                         -->
    <!-- ========================================================================= -->
    <section class="bg-cream py-20 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Copy & Highlights (7 cols) -->
        <div class="lg:col-span-7" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Specialized Engineering Overview
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-ink font-bold tracking-tight mb-6">
            Precision Built for UAE Weather & Municipal Standards
          </h2>

          <div class="space-y-4 font-body text-ink-soft text-sm sm:text-base leading-relaxed mb-8">
            {service.fullOverview.map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>

          <!-- Feature Highlights Callout Box -->
          <div class="bg-sand p-6 sm:p-7 rounded-2xl border border-hairline shadow-sm">
            <h3 class="font-mono text-xs uppercase tracking-wider text-ink font-bold mb-3">
              Standard Engineering Deliverables:
            </h3>
            <ul class="grid sm:grid-cols-2 gap-2.5">
              {service.features.map(feature => (
                <li class="flex items-center gap-2 text-xs sm:text-sm font-body text-ink-soft">
                  <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                  <span>{feature}</span>
                </li>
              ))}
              <li class="flex items-center gap-2 text-xs sm:text-sm font-body text-ink-soft">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                <span>Sharjah Al Dhaid in-house manufacturing</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm font-body text-ink-soft">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                <span>Turnkey installation across all 7 Emirates</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Right Column: Visual Showcase (5 cols) -->
        <div class="lg:col-span-5" data-reveal="scale-up" data-reveal-delay="0.1">
          <div class="space-y-4">
            <!-- Main Featured Image -->
            <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-canvas aspect-[4/3] bg-navy-darker group">
              <img 
                src={service.image} 
                alt={`${service.title} UAE Installation`} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 [image-rendering:-webkit-optimize-contrast]"
              />
            </div>

            <!-- Secondary Gallery Thumbnails -->
            {service.secondaryImages && service.secondaryImages.length > 0 && (
              <div class="grid grid-cols-2 gap-4">
                {service.secondaryImages.slice(0, 2).map((imgUrl, i) => (
                  <div class="rounded-2xl overflow-hidden shadow-md border-2 border-canvas aspect-[16/10] bg-navy-darker group">
                    <img 
                      src={imgUrl} 
                      alt={`${service.title} detail ${i + 1}`} 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 [image-rendering:-webkit-optimize-contrast]"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. TYPES & ARCHITECTURAL CONFIGURATIONS SECTION                           -->
    <!-- ========================================================================= -->
    <section class="bg-sand-soft py-20 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Available Designs & Configurations
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-ink font-bold tracking-tight mb-4">
            Types of {service.title}
          </h2>
          <p class="font-body text-ink-soft text-sm sm:text-base">
            Every site presents unique architectural and spatial requirements. Explore our proven structural variants fabricated to order in Sharjah Al Dhaid.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {service.types.map((type, idx) => (
            <div 
              class="bg-canvas p-7 rounded-2xl border border-hairline shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1"
              data-reveal="fade-up"
              data-reveal-delay={String((idx % 3) * 0.08)}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs text-primary font-bold uppercase tracking-wider">Type 0{idx + 1}</span>
                  <span class="w-2 h-2 rounded-full bg-gold-accent"></span>
                </div>
                <h3 class="font-display font-bold text-xl text-ink mb-3 group-hover:text-primary transition-colors">
                  {type.name}
                </h3>
                <p class="font-body text-ink-soft text-xs sm:text-sm leading-relaxed mb-6">
                  {type.description}
                </p>
              </div>

              <div class="pt-5 border-t border-hairline/80 space-y-3">
                <div>
                  <span class="font-mono text-[10px] text-ink-muted uppercase tracking-wider block mb-1">Ideal For:</span>
                  <p class="font-body text-xs font-medium text-ink leading-normal">{type.idealFor}</p>
                </div>

                {type.features && (
                  <div>
                    <span class="font-mono text-[10px] text-ink-muted uppercase tracking-wider block mb-1">Key Advantages:</span>
                    <ul class="space-y-1">
                      {type.features.map(f => (
                        <li class="text-[11px] font-body text-ink-soft flex items-center gap-1.5">
                          <span class="w-1 h-1 rounded-full bg-primary shrink-0"></span>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. TECHNICAL SPECIFICATIONS MATRIX & DESIGN STANDARDS                     -->
    <!-- ========================================================================= -->
    <section class="bg-navy-canvas py-20 px-6 sm:px-10 lg:px-16 border-b border-navy-mid relative overflow-hidden text-canvas">
      <!-- Ambient Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-3xl mb-14" data-reveal="fade-up">
          <span class="font-mono text-gold-accent text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Engineering & Technical Specifications
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-canvas font-bold tracking-tight mb-4">
            Technical Standards & Quality Compliance
          </h2>
          <p class="font-body text-ink-secondary text-sm sm:text-base leading-relaxed">
            All structural calculations, wind engineering, and materials comply with UAE Civil Defense and Dubai/Sharjah/Abu Dhabi Municipality engineering codes.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {service.specifications.map((specCat, idx) => (
            <div 
              class="bg-navy-darker/90 p-7 rounded-2xl border border-navy-mid hover:border-gold-accent/40 transition-all duration-300 shadow-xl"
              data-reveal="fade-up"
              data-reveal-delay={String(idx * 0.1)}
            >
              <div class="flex items-center gap-2 mb-5 pb-3 border-b border-navy-mid/70">
                <span class="w-2 h-2 rounded-full bg-gold-accent"></span>
                <h3 class="font-display font-bold text-lg text-canvas">{specCat.category}</h3>
              </div>

              <div class="space-y-4">
                {specCat.details.map(item => (
                  <div>
                    <span class="font-mono text-[10.5px] uppercase tracking-wider text-ink-muted block mb-0.5">
                      {item.label}
                    </span>
                    <span class="font-body font-semibold text-xs sm:text-sm text-canvas leading-snug block">
                      {item.value}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 5. MATERIALS & FABRICS ALL DATA SHOWCASE                                  -->
    <!-- ========================================================================= -->
    <section class="bg-cream py-20 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
            Material Science & Coatings
          </span>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-ink font-bold tracking-tight mb-4">
            Certified Materials & Technical Fabrics
          </h2>
          <p class="font-body text-ink-soft text-sm sm:text-base">
            Imported technical membranes and certified structural steel selected specifically to resist high UV index, sandstorms, and coastal salinity.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
          {service.materials.map((mat, idx) => (
            <div 
              class="bg-canvas p-7 rounded-2xl border border-hairline shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
              data-reveal="fade-up"
              data-reveal-delay={String(idx * 0.1)}
            >
              <div>
                <span class="font-mono text-[11px] text-primary uppercase font-bold tracking-wider mb-2 block">
                  {mat.type}
                </span>
                <h3 class="font-display font-bold text-xl text-ink mb-3">{mat.name}</h3>
                <p class="font-body text-ink-soft text-xs sm:text-sm leading-relaxed mb-6">
                  {mat.benefits}
                </p>
              </div>

              <div class="pt-5 border-t border-hairline flex items-center justify-between font-mono text-xs">
                <div>
                  <span class="text-ink-muted block text-[10px] uppercase">Lifespan:</span>
                  <span class="font-bold text-ink">{mat.lifespan}</span>
                </div>
                {mat.uvProtection && (
                  <div class="text-right">
                    <span class="text-ink-muted block text-[10px] uppercase">Rating:</span>
                    <span class="font-bold text-primary">{mat.uvProtection}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 6. EXPLORE OTHER SPECIALIZED DIVISIONS                                    -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker py-16 px-6 sm:px-10 lg:px-16 border-b border-navy-mid">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h3 class="font-display font-bold text-xl text-canvas">Explore Other Services</h3>
          <a href="/#services" class="text-xs font-mono text-gold-accent hover:text-canvas transition-colors">
            View All 8 Services →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {otherServices.slice(0, 4).map(other => (
            <a 
              href={`/services/${other.slug}`}
              class="bg-navy-card p-4 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 flex items-center gap-3.5 group"
            >
              <img 
                src={other.image} 
                alt={other.title} 
                class="w-14 h-14 rounded-lg object-cover shrink-0 bg-navy-darker"
                loading="lazy"
              />
              <div>
                <span class="font-mono text-[9.5px] text-gold-accent block">{other.category}</span>
                <span class="font-body font-semibold text-xs text-canvas group-hover:text-gold-accent transition-colors leading-tight line-clamp-1 block">
                  {other.title}
                </span>
                <span class="text-[10px] text-ink-muted group-hover:text-ink-secondary transition-colors">View specs →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 7. UNIFORM CONSULTATION BANNER, CLIENT REVIEWS & FOOTER                   -->
    <!-- ========================================================================= -->
    <ContactCTA />
    <ClientsMarquee />
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../../scripts/animations';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initWebsiteAnimations());
  } else {
    initWebsiteAnimations();
  }
</script>
