---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ClientsMarquee from '../../components/ClientsMarquee.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { services, type ServiceCategory } from '../../data/services';

export async function getStaticPaths() {
  return services.map(category => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

interface Props {
  category: ServiceCategory;
}

const { category } = Astro.props;

// Other categories for cross-navigation
const otherCategories = services.filter(c => c.slug !== category.slug);
---

<Layout
  title={category.metaTitle}
  description={category.metaDescription}
>
  <Header />

  <main>
    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION (SPLIT)                                                   -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker relative overflow-hidden text-canvas pt-24 pb-32 lg:pt-32 lg:pb-40 px-6 sm:px-10 lg:px-16 border-b border-navy-mid">
      <!-- Subtle ambient glows -->
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[140px] pointer-events-none mix-blend-screen"></div>
      <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-gold-accent/5 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left: Copy (7 cols) -->
        <div class="lg:col-span-7" data-reveal="fade-up">
          <div class="flex items-center gap-4 mb-8" data-reveal="fade-right">
            <div class="h-[1px] w-8 sm:w-16 bg-gold-accent relative">
              <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-gold-accent rotate-45 shadow-[0_0_10px_rgba(250,204,21,0.8)]"></div>
            </div>
            <span class="font-mono text-[10px] sm:text-xs text-gold-accent uppercase tracking-[0.3em] font-bold drop-shadow-md">
              {category.subItems.length} Specialized Solutions <span class="mx-2 opacity-50">/</span> UAE Wide
            </span>
          </div>

          <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl tracking-tight text-white mb-6 leading-tight drop-shadow-lg">
            {category.name}
          </h1>

          <p class="font-body text-canvas/80 text-lg sm:text-xl max-w-2xl mb-10 leading-relaxed">
            {category.intro}
          </p>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
            <a 
              href="/contact" 
              class="btn-live-primary btn-shimmer w-full sm:w-auto font-body font-bold text-sm px-8 py-4 rounded-xl flex items-center justify-center gap-2 shadow-[0_10px_30px_rgba(30,58,138,0.4)] hover:-translate-y-1 transition-transform duration-300"
            >
              <span>Request Quotation</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

            <a 
              href={`https://wa.me/971505077179?text=Hello%20Al%20Sahra,%20I%20am%20interested%20in%20a%20quotation%20for%20${encodeURIComponent(category.name)}.`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto bg-navy-card hover:bg-navy-mid text-white font-body font-bold text-sm px-8 py-4 rounded-xl border border-navy-border hover:border-gold-accent transition-all duration-300 flex items-center justify-center gap-2 shadow-2xl hover:-translate-y-1"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"></span>
              <span>WhatsApp Fast Support</span>
            </a>
          </div>
        </div>

        <!-- Right: Image Showcase (5 cols) -->
        <div class="lg:col-span-5 relative" data-reveal="fade-up" data-reveal-delay="0.1">
          <!-- Decorative frame behind image -->
          <div class="absolute -inset-4 bg-gradient-to-br from-primary/30 to-gold-accent/20 rounded-[2.5rem] transform rotate-3 blur-md opacity-70"></div>
          
          <div class="relative rounded-[2rem] overflow-hidden border-4 border-navy-mid shadow-[0_20px_50px_rgba(0,0,0,0.5)] bg-navy-darker group aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5]">
            <img 
              src={category.heroImage} 
              alt={category.name} 
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="eager"
            />
            <!-- Inner shadow gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-darker/80 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. FLOATING OVERVIEW METRICS                                              -->
    <!-- ========================================================================= -->
    <section class="relative z-20 -mt-24 px-6 sm:px-10 lg:px-16 max-w-7xl mx-auto">
      <div class="bg-white shadow-[0_30px_60px_rgba(0,0,0,0.15)] rounded-2xl overflow-hidden border border-hairline flex flex-col lg:flex-row" data-reveal="fade-up">
        
        <!-- Left: Text -->
        <div class="p-10 lg:p-14 lg:w-3/5 flex flex-col justify-center bg-sand-soft/30 relative overflow-hidden">
          <span class="font-mono text-gold-accent text-[10px] uppercase tracking-[0.3em] font-bold block mb-4 flex items-center gap-3">
            <span class="h-[1px] w-8 bg-gold-accent"></span> Service Overview
          </span>
          <h2 class="font-display text-3xl sm:text-4xl text-ink font-bold tracking-tight mb-5 leading-tight">
            Engineered for the UAE Climate
          </h2>
          <p class="font-body text-ink-soft text-base leading-relaxed max-w-2xl">
            {category.metaDescription || category.intro}
          </p>
        </div>

        <!-- Right: Stats -->
        <div class="lg:w-2/5 flex flex-col sm:flex-row border-t lg:border-t-0 lg:border-l border-hairline bg-white">
          <!-- Metric 1 -->
          <div class="flex-1 p-8 border-b sm:border-b-0 sm:border-r border-hairline flex flex-col justify-center items-center sm:items-start group hover:bg-sand-soft/50 transition-colors">
            <div class="font-display text-4xl sm:text-5xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform origin-center sm:origin-left duration-500">10<span class="text-gold-accent">+</span></div>
            <div class="font-mono text-[10px] text-ink-muted uppercase tracking-[0.2em] font-bold">Years Exp</div>
          </div>
          <!-- Metric 2 & 3 Combined -->
          <div class="flex-1 p-8 pb-16 sm:pb-8 flex flex-col justify-center items-center sm:items-start relative group hover:bg-sand-soft/50 transition-colors">
            <div class="font-display text-4xl sm:text-5xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform origin-center sm:origin-left duration-500">100<span class="text-gold-accent">%</span></div>
            <div class="font-mono text-[10px] text-ink-muted uppercase tracking-[0.2em] font-bold mb-6 sm:mb-0">Warranty</div>
            
            <!-- Municipality Approved badge -->
            <div class="absolute bottom-5 sm:bottom-8 left-1/2 sm:left-8 -translate-x-1/2 sm:translate-x-0 w-max bg-navy-card text-white px-3 py-1.5 rounded border border-white/10 shadow-lg flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gold-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span class="font-mono text-[8px] uppercase tracking-[0.1em] font-bold">Municipality Approved</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. SUB-ITEMS SECTIONS (each as H2/H3 on-page section)                    -->
    <!-- ========================================================================= -->
    <section class="bg-canvas pt-32 pb-24 px-6 sm:px-10 lg:px-16 border-b border-hairline relative overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-4">
            Our Solutions
          </span>
          <h2 class="font-display text-4xl sm:text-5xl text-ink font-bold tracking-tight mb-6">
            {category.name}
          </h2>
          <p class="font-body text-ink-soft text-lg sm:text-xl">
            Explore the full range of solutions available within this service category, each engineered and installed by our team across the UAE.
          </p>
        </div>

        <div class={`grid gap-6 sm:gap-8 mx-auto ${category.subItems.length === 1 ? 'grid-cols-1 max-w-4xl' : category.subItems.length <= 4 ? 'md:grid-cols-2' : category.subItems.length <= 6 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'}`}>
          {category.subItems.map((sub, idx) => {
            const CardTag = sub.hasDedicatedPage ? 'a' : 'div';
            const cardProps = sub.hasDedicatedPage 
              ? { href: `/services/${category.slug}/${sub.slug}`, 'aria-label': `Explore ${sub.name}` }
              : {};

            return (
              <CardTag 
                {...cardProps}
                class={`bg-white rounded-3xl border border-hairline shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] transition-all duration-500 flex flex-col justify-between group hover:-translate-y-2 relative overflow-hidden ${sub.hasDedicatedPage ? 'cursor-pointer block no-underline text-inherit' : ''}`}
                data-reveal="fade-up"
                data-reveal-delay={String((idx % 4) * 0.08)}
              >
                <!-- Image Section (Top, Edge-to-Edge) -->
                <div class="relative w-full aspect-[16/10] bg-sand overflow-hidden">
                  <!-- Floating Glassmorphism Badge -->
                  <div class="absolute top-4 left-4 z-20 flex items-center gap-2 bg-black/30 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/20 shadow-sm">
                    <span class="font-mono text-[10px] text-white font-bold tracking-wider drop-shadow-md">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-accent shadow-[0_0_8px_rgba(250,204,21,0.8)]"></span>
                  </div>

                  <!-- Solution Image (or Placeholder) -->
                  {sub.images && sub.images.length > 0 ? (
                    <div class="w-full h-full relative group/carousel">
                      <style>
                        .hide-scrollbar::-webkit-scrollbar { display: none; }
                      </style>
                      <div 
                        class="flex overflow-x-auto snap-x snap-mandatory h-full w-full scroll-smooth hide-scrollbar auto-scroll-carousel" 
                        style="scrollbar-width: none; -ms-overflow-style: none;"
                      >
                        {sub.images.map((img) => (
                          <div class="h-full shrink-0 snap-center relative" style="flex: 0 0 100%;">
                            <img 
                              src={img} 
                              alt={sub.name} 
                              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                              loading="lazy" 
                            />
                          </div>
                        ))}
                      </div>
                      <!-- Multi-photo count & swipe indicator -->
                      {sub.images.length > 1 && (
                        <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md rounded-full px-2.5 py-1 text-[10px] font-mono text-white flex items-center gap-1.5 shadow-sm transition-opacity group-hover/carousel:opacity-100">
                          <span>{sub.images.length} photos</span>
                          <svg class="w-3 h-3 text-gold-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </div>
                      )}
                    </div>
                  ) : sub.image ? (
                    <img 
                      src={sub.image} 
                      alt={sub.name} 
                      class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                      loading="lazy" 
                    />
                  ) : (
                    <div class="w-full h-full bg-sand-soft flex flex-col items-center justify-center relative transition-colors">
                      <svg class="w-8 h-8 text-ink-muted/30 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span class="font-mono text-[10px] text-ink-muted/50 uppercase tracking-[0.2em]">Photo Pending</span>
                    </div>
                  )}
                </div>

                <!-- Text Content Section (Bottom, Padded) -->
                <div class="p-8 flex flex-col flex-1">
                  <div class="flex-1 mb-6">
                    <h3 class="font-display font-bold text-2xl text-ink mb-3 group-hover:text-primary transition-colors">
                      {sub.name}
                    </h3>
                    <p class="font-body text-ink font-semibold text-sm leading-relaxed mb-3">
                      {sub.description}
                    </p>
                    {sub.details && (
                      <p class="font-body text-ink-soft text-sm leading-relaxed line-clamp-3 group-hover:line-clamp-none transition-all duration-500">
                        {sub.details}
                      </p>
                    )}
                  </div>

                  <div class="pt-5 border-t border-hairline/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-auto">
                    <span class="text-[10px] font-mono bg-cream text-ink-muted px-2.5 py-1 rounded-md border border-hairline inline-block max-w-fit">
                      {sub.keyword}
                    </span>

                    {sub.hasDedicatedPage ? (
                      <div 
                        class="flex items-center justify-center sm:justify-start gap-1.5 text-xs font-bold text-primary group-hover:text-primary-dark transition-colors uppercase tracking-wider"
                      >
                        <span>Explore</span>
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </div>
                    ) : (
                      <a 
                        href="/contact"
                        class="flex items-center justify-center sm:justify-start gap-1.5 text-xs font-bold text-gold-accent hover:text-ink transition-colors uppercase tracking-wider"
                      >
                        <span>Get Quote</span>
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </CardTag>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. EXPLORE OTHER CATEGORIES                                               -->
    <!-- ========================================================================= -->
    <section class="bg-navy-darker py-16 px-6 sm:px-10 lg:px-16 border-b border-navy-mid">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h3 class="font-display font-bold text-xl text-canvas">Explore Other Services</h3>
          <a href="/#services" class="text-xs font-mono text-gold-accent hover:text-canvas transition-colors">
            View All 9 Services →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {otherCategories.slice(0, 4).map(other => (
            <a 
              href={`/services/${other.slug}`}
              class="bg-navy-card p-4 rounded-xl border border-navy-border hover:border-gold-accent/40 transition-all duration-300 flex items-center gap-3.5 group"
            >
              <img 
                src={other.heroImage} 
                alt={other.name} 
                class="w-14 h-14 rounded-lg object-cover shrink-0 bg-navy-darker"
                loading="lazy"
              />
              <div>
                <span class="font-mono text-[9.5px] text-gold-accent block">{other.subItems.length} Solutions</span>
                <span class="font-body font-semibold text-xs text-canvas group-hover:text-gold-accent transition-colors leading-tight line-clamp-1 block">
                  {other.name}
                </span>
                <span class="text-[10px] text-ink-muted group-hover:text-ink-secondary transition-colors">View details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 5. CONSULTATION BANNER & CLIENT REVIEWS                                   -->
    <!-- ========================================================================= -->
    <ContactCTA />
    <ClientsMarquee />
  </main>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { initWebsiteAnimations } from '../../scripts/animations';

  // Global interval to automatically scroll any carousels on the page
  // This bypasses any Astro lifecycle bugs or view transition issues
  setInterval(() => {
    // Find all carousels that are NOT currently being hovered
    const carousels = document.querySelectorAll('.auto-scroll-carousel:not(:hover)');
    
    carousels.forEach((carousel: any) => {
      // Skip if the carousel is not visible on the screen
      if (carousel.offsetParent === null || carousel.clientWidth === 0) return;
      
      // Scroll to next image, or loop back to start
      if (Math.ceil(carousel.scrollLeft + carousel.clientWidth) >= carousel.scrollWidth - 10) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: carousel.clientWidth, behavior: 'smooth' });
      }
    });
  }, 3000);

  const init = () => {
    try { initWebsiteAnimations(); } catch(e) { console.error('Animation init failed:', e); }
  };

  document.addEventListener('astro:page-load', init);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    setTimeout(init, 100);
  }
</script>
