---
import { clients } from '../data/clients';
---
<section class="bg-cream py-16 overflow-hidden border-y border-hairline relative">
  <div class="max-w-6xl mx-auto px-6 mb-8 text-center">
    <h2 class="font-display text-2xl text-ink">Trusted by leading names across the UAE</h2>
  </div>
  
  <div class="marquee-track flex overflow-hidden">
    <div class="marquee-group flex gap-16 items-center shrink-0 min-w-full">
      {clients.map(c => (
        <img src={c.logoSrc} alt={c.name} class="h-16 w-auto object-contain opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
      ))}
    </div>
    <div class="marquee-group flex gap-16 items-center shrink-0 min-w-full" aria-hidden="true">
      {clients.map(c => (
        <img src={c.logoSrc} alt="" class="h-16 w-auto object-contain opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
      ))}
    </div>
  </div>
</section>

<style>
.marquee-track {
  mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
}
.marquee-group {
  animation: scroll-rtl 40s linear infinite;
}
.marquee-track:hover .marquee-group {
  animation-play-state: paused;
}
@keyframes scroll-rtl {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}
</style>
