---
import { clients } from '../data/clients';
---
<section class="bg-cream py-16 px-6 overflow-hidden border-t border-hairline">
  <div class="max-w-7xl mx-auto mb-10 text-center" data-reveal="fade-up">
    <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-2">
      Selected Project References
    </span>
    <h3 class="font-display font-medium text-2xl sm:text-3xl text-ink">
      Trusted by Leading Organizations Across the UAE
    </h3>
    <p class="font-body text-ink-soft text-sm mt-2">
      Public and private sector projects spanning aviation, education, hospitality, and civic developments.
    </p>
  </div>

  <!-- Marquee Track Wrapper -->
  <div class="relative w-full overflow-hidden mask-fade-edges">
    <!-- Gradient Masks at edges -->
    <div class="absolute left-0 inset-y-0 w-16 sm:w-32 bg-gradient-to-r from-cream to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 inset-y-0 w-16 sm:w-32 bg-gradient-to-l from-cream to-transparent z-10 pointer-events-none"></div>

    <!-- The Infinite Running Track (repeated twice for seamless loop) -->
    <div class="animate-marquee flex items-center gap-12 sm:gap-16 py-4">
      {clients.concat(clients).map((client, idx) => (
        <div 
          class="flex flex-col items-center justify-center p-4 rounded-xl bg-canvas border border-hairline shadow-xs hover:shadow-md transition-all duration-300 min-w-[160px] sm:min-w-[190px] h-[90px] shrink-0 group hover:border-primary/40"
        >
          <img 
            src={client.logoSrc} 
            alt={client.name} 
            class="max-h-12 max-w-[140px] w-auto object-contain filter grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-300"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Footnote -->
  <div class="mt-8 text-center">
    <span class="font-mono text-xs text-ink-muted">
      + Meydan • Sheraton • Abu Dhabi Airport • Shurooq • DWC • University of Sharjah • Hilton • Zayed University • Gargash • Al Ain Zoo • Radisson Blu & many more
    </span>
  </div>
</section>
