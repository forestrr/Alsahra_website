---
import { services } from '../data/services';
---
<section id="services" class="bg-navy-canvas py-24 px-6 sm:px-10 lg:px-16 relative overflow-hidden">
  <!-- Decorative background subtle glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[500px] bg-gold-accent/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16" data-reveal="fade-up">
      <div class="max-w-3xl">
        <span class="font-mono text-gold-accent text-xs uppercase tracking-[2px] font-semibold block mb-3">
          Our Core Services & Manufacturing
        </span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-[46px] leading-[1.14] tracking-[-0.4px] text-canvas mb-4">
          Engineered Shades, Tents & Structural Steel
        </h2>
        <p class="font-body text-ink-secondary text-base sm:text-lg leading-relaxed">
          Explore our 9 specialized manufacturing and installation divisions. Forged with certified precision in our Sharjah Al Dhaid facility and installed across all 7 Emirates.
        </p>
      </div>

      <a 
        href="/contact" 
        class="text-sm font-semibold text-gold-accent hover:text-canvas transition-colors inline-flex items-center gap-2 shrink-0"
      >
        <span>Need custom project specifications?</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- 9 Core Services Grid (3x3) -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
      {services.map((category, idx) => (
        <a 
          href={`/services/${category.slug}`}
          class="bg-navy-card rounded-2xl overflow-hidden border border-navy-border hover:border-gold-accent/50 transition-all duration-300 flex flex-col group hover:-translate-y-2 shadow-lg hover:shadow-2xl hover:shadow-black/40 cursor-pointer"
          data-reveal="fade-up"
          data-reveal-delay={String((idx % 3) * 0.08)}
        >
          <!-- Image Frame -->
          <div class="relative aspect-[16/11] overflow-hidden bg-navy-darker">
            <img 
              src={category.heroImage} 
              alt={category.name} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108 [image-rendering:-webkit-optimize-contrast]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-card via-navy-card/30 to-transparent opacity-70 group-hover:opacity-50 transition-opacity"></div>
            
            <!-- Sub-item count badge -->
            <span class="absolute top-3 left-3 text-[10.5px] font-mono px-2.5 py-1 rounded-md bg-navy-darker/80 backdrop-blur-md text-gold-accent border border-white/10 shadow-sm">
              {category.subItems.length} Solutions
            </span>

            <!-- Quick Arrow Icon Button -->
            <div class="absolute bottom-3 right-3 w-8 h-8 rounded-full bg-navy-darker/80 backdrop-blur-md border border-white/10 flex items-center justify-center text-canvas group-hover:bg-primary group-hover:border-primary transition-all duration-300 shadow-md">
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </div>

          <!-- Content Area -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="font-mono text-[10px] text-ink-muted uppercase tracking-wider mb-1">Service Division {String(idx + 1).padStart(2, '0')}</div>
              <h3 class="font-display font-bold text-xl text-canvas mb-2.5 group-hover:text-gold-accent transition-colors">
                {category.name}
              </h3>
              <p class="font-body text-ink-secondary text-xs leading-relaxed mb-4 line-clamp-3">
                {category.intro}
              </p>
            </div>

            <!-- Sub-item Pills & Action -->
            <div>
              <div class="pt-4 border-t border-navy-mid/70 flex flex-wrap gap-1.5 mb-4">
                {category.subItems.slice(0, 3).map(sub => (
                  <span class="text-[10px] font-mono bg-navy-darker/80 text-ink-secondary px-2 py-0.5 rounded border border-white/5">
                    {sub.name}
                  </span>
                ))}
                {category.subItems.length > 3 && (
                  <span class="text-[10px] font-mono bg-navy-darker/80 text-gold-accent px-2 py-0.5 rounded border border-white/5">
                    +{category.subItems.length - 3} more
                  </span>
                )}
              </div>

              <div class="flex items-center gap-1.5 text-xs font-semibold text-gold-accent group-hover:text-canvas transition-colors">
                <span>Explore Solutions</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
