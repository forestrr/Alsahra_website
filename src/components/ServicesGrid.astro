---
import { services } from '../data/services';
---
<section id="products" class="bg-navy-canvas py-[80px] px-6 md:px-16">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <span class="font-mono text-primary text-xs uppercase tracking-[1px] block mb-4">Our Products & Services</span>
      <h2 class="font-display text-[44px] leading-tight tracking-[-0.4px] text-canvas">
        Engineered for every site.
      </h2>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(service => (
        <div class="bg-navy-darker rounded-[20px] p-6 border border-navy-mid flex flex-col justify-between hover:border-primary-soft transition-colors duration-300">
          <div>
            <h3 class="font-body font-semibold text-[22px] text-canvas mb-3">{service.name}</h3>
            <p class="font-body text-ink-secondary text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
