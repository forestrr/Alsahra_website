---
import { servicePillars, featuredServices } from '../data/services';
---
<section id="services" class="bg-navy-canvas py-24 px-6 sm:px-10 lg:px-16 relative overflow-hidden">
  <!-- Decorative background subtle glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="mb-16 max-w-3xl" data-reveal="fade-up">
      <span class="font-mono text-gold-accent text-xs uppercase tracking-[2px] font-semibold block mb-4">
        Our Services & Manufacturing
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-[48px] leading-[1.12] tracking-[-0.4px] text-canvas mb-6">
        Manufacturing & Installation Across Shade, Tents & Structural Metal
      </h2>
      <p class="font-body text-ink-secondary text-base sm:text-lg leading-relaxed">
        From custom tensile membranes to heavy structural steel trusses, everything is forged in our Sharjah facility and installed by our in-house engineering crews.
      </p>
    </div>

    <!-- 3 Core Pillars Cards -->
    <div class="grid lg:grid-cols-3 gap-8 mb-20">
      {servicePillars.map((pillar, idx) => (
        <div 
          class="bg-navy-darker/90 rounded-2xl p-8 border border-navy-mid hover:border-gold-accent/50 transition-all duration-300 flex flex-col justify-between group shadow-xl hover:-translate-y-1"
          data-reveal="fade-up"
          data-reveal-delay={String(idx * 0.1)}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-gold-accent uppercase tracking-wider font-semibold">Pillar 0{idx + 1}</span>
              <div class="w-8 h-8 rounded-lg bg-navy-mid/60 flex items-center justify-center text-canvas group-hover:text-gold-accent transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </div>
            </div>
            <h3 class="font-display font-bold text-2xl text-canvas mb-3 group-hover:text-gold-accent transition-colors">{pillar.title}</h3>
            <p class="font-body text-ink-secondary text-sm leading-relaxed mb-6">
              {pillar.tagline}
            </p>
          </div>

          <div class="pt-6 border-t border-navy-mid/60">
            <h4 class="font-mono text-xs uppercase tracking-wider text-canvas/70 mb-3">Product Range:</h4>
            <ul class="space-y-2">
              {pillar.items.map(item => (
                <li class="flex items-center gap-2.5 text-xs font-body text-ink-secondary">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Featured Service Cards with High-Res Images & Technical Specs -->
    <div class="pt-12 border-t border-navy-mid" data-reveal="fade-up">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-2">Detailed Offerings</span>
          <h3 class="font-display text-2xl sm:text-3xl text-canvas">
            Engineered solutions for every site
          </h3>
        </div>
        <a 
          href="#contact" 
          class="text-sm font-semibold text-gold-accent hover:text-canvas transition-colors inline-flex items-center gap-2"
        >
          <span>Need custom specs? Contact our engineers</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredServices.map((service, idx) => (
          <div 
            class="bg-navy-card rounded-2xl overflow-hidden border border-navy-border hover:border-primary-soft transition-all duration-300 flex flex-col group hover:-translate-y-1.5 shadow-lg"
            data-reveal="fade-up"
            data-reveal-delay={String((idx % 4) * 0.08)}
          >
            <!-- Image Frame -->
            <div class="relative aspect-[16/11] overflow-hidden bg-navy-darker">
              <img 
                src={service.image} 
                alt={service.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-card via-transparent to-transparent opacity-60"></div>
              <span class="absolute top-3 left-3 text-[11px] font-mono px-2.5 py-1 rounded bg-navy-darker/80 backdrop-blur-sm text-gold-accent border border-white/10">
                {service.category}
              </span>
            </div>

            <!-- Content Area -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h4 class="font-body font-bold text-lg text-canvas mb-2.5 group-hover:text-gold-accent transition-colors">
                  {service.title}
                </h4>
                <p class="font-body text-ink-secondary text-xs leading-relaxed mb-4">
                  {service.description}
                </p>
              </div>

              <!-- Technical Specs Pills -->
              {service.specs && (
                <div class="pt-4 border-t border-navy-mid/70 flex flex-wrap gap-1.5">
                  {service.specs.slice(0, 2).map(spec => (
                    <span class="text-[10px] font-mono bg-navy-darker/80 text-ink-secondary px-2 py-0.5 rounded border border-white/5">
                      {spec}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
