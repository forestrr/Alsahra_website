---
import { Image } from 'astro:assets';
---
<section class="bg-cream pt-[60px] pb-[60px] px-12 md:px-16 lg:pl-[60px] lg:pr-12 relative overflow-hidden">
  <div class="max-w-4xl relative z-10">
    <h1 class="font-display font-medium text-5xl md:text-[56px] leading-[1.1] tracking-[-0.5px] text-ink mb-6">
      Shade and Shelter, Engineered for the Desert
    </h1>
    <p class="font-body text-[19px] leading-relaxed text-ink-soft mb-10 max-w-2xl">
      Al Sahra Tents & Sheds Fix designs, manufactures, and installs tensile shades, tents, awnings, and steel structures across the UAE — trusted by hotels, airports, universities, and contractors.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="#contact" class="bg-primary text-canvas font-body font-semibold text-sm px-6 py-3 rounded-md hover:bg-primary-soft transition-colors h-[44px] flex items-center justify-center">
        Get a Free Quote
      </a>
      <a href="#work" class="bg-transparent text-ink border border-ink font-body font-semibold text-sm px-6 py-3 rounded-md hover:bg-ink hover:text-canvas transition-colors h-[44px] flex items-center justify-center">
        View Our Projects
      </a>
    </div>
  </div>
</section>
