<!-- Hero Video Interactive Controller Script with Mobile Autoplay Assurance -->
<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
    const toggleBtn = document.getElementById('video-toggle-btn');
    const pauseIcon = document.getElementById('video-pause-icon');
    const playIcon = document.getElementById('video-play-icon');

    if (!video) return;

    // Mobile Autoplay Assurance (iOS Low-Power mode / gesture unlock)
    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        // Auto-play was prevented by mobile browser policies; play on first interaction
        const startPlayOnInteraction = () => {
          video.play().catch(() => {});
          document.removeEventListener('touchstart', startPlayOnInteraction);
          document.removeEventListener('scroll', startPlayOnInteraction);
        };
        document.addEventListener('touchstart', startPlayOnInteraction, { passive: true, once: true });
        document.addEventListener('scroll', startPlayOnInteraction, { passive: true, once: true });
      });
    }

    if (toggleBtn) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (video.paused) {
          video.play();
          pauseIcon?.classList.remove('hidden');
          playIcon?.classList.add('hidden');
        } else {
          video.pause();
          pauseIcon?.classList.add('hidden');
          playIcon?.classList.remove('hidden');
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>

