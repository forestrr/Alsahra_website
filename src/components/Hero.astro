      <!-- Trust Metrics Floating Pill Bar (100% Legible across all Video Frames) -->
      <div class="mt-5 sm:mt-6 inline-flex flex-wrap items-center gap-3.5 sm:gap-6 bg-navy-darker/85 backdrop-blur-md px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl border border-white/20 shadow-2xl">
        <div class="flex items-center gap-2.5">
          <span class="font-display text-xl sm:text-2xl font-bold text-amber-300 drop-shadow-sm">500+</span>
          <span class="text-[11px] sm:text-xs font-mono font-medium text-white leading-tight">Projects Built<br/><span class="text-white/80">Across UAE</span></span>
        </div>
        <div class="h-6 w-px bg-white/20 hidden sm:block"></div>
        <div class="flex items-center gap-2.5">
          <span class="font-display text-xl sm:text-2xl font-bold text-emerald-400 drop-shadow-sm">100%</span>
          <span class="text-[11px] sm:text-xs font-mono font-medium text-white leading-tight">In-House Facility<br/><span class="text-white/80">Sharjah Al Dhaid</span></span>
        </div>
        <div class="h-6 w-px bg-white/20 hidden sm:block"></div>
        <div class="flex items-center gap-2.5">
          <span class="font-display text-xl sm:text-2xl font-bold text-white drop-shadow-sm">24/7</span>
          <span class="text-[11px] sm:text-xs font-mono font-medium text-white leading-tight">Turnkey Support<br/><span class="text-white/80">& Renovation</span></span>
