  <!-- Bottom Floating Video Playback & Sound Control Pill -->
  <div class="absolute bottom-4 right-6 z-20 hidden md:flex items-center gap-2 bg-navy-darker/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10 text-[11px] font-mono text-ink-secondary shadow-xl">
    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
    <span>Background Reel</span>
    <button 
      id="video-toggle-btn"
      type="button" 
      class="ml-2 hover:text-canvas transition-colors p-1"
      aria-label="Pause or Play Background Video"
      title="Pause / Play Video"
    >
      <svg id="video-pause-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <svg id="video-play-icon" class="w-3.5 h-3.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </button>
  </div>
</section>

<!-- Hero Video Interactive Controller Script -->
<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
    const toggleBtn = document.getElementById('video-toggle-btn');
    const pauseIcon = document.getElementById('video-pause-icon');
    const playIcon = document.getElementById('video-play-icon');

    if (!video || !toggleBtn) return;

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        pauseIcon?.classList.remove('hidden');
        playIcon?.classList.add('hidden');
      } else {
        video.pause();
        pauseIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>

