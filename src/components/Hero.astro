<section class="relative min-h-[88vh] lg:min-h-[92vh] flex items-center py-6 sm:py-8 md:py-10 px-6 sm:px-10 lg:px-16 overflow-hidden bg-navy-darker text-canvas">
  <!-- ========================================================================= -->
  <!-- HERO BACKGROUND VIDEO (SEAMLESS EDGE-TO-EDGE COVER - ZERO GAPS ABOVE/BELOW) -->
  <!-- ========================================================================= -->
