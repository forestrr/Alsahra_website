      <!-- Bottom Trust Metrics Bar -->
      <div class="mt-12 pt-8 border-t border-white/10 flex flex-wrap items-center gap-6 sm:gap-10 text-xs font-mono text-ink-secondary">
        <div class="flex items-center gap-2">
          <span class="font-display text-xl font-bold text-gold-accent">500+</span>
          <span class="leading-tight">Projects Built<br/>Across UAE</span>
        </div>
        <div class="h-6 w-px bg-white/15 hidden sm:block"></div>
        <div class="flex items-center gap-2">
          <span class="font-display text-xl font-bold text-primary-light">100%</span>
          <span class="leading-tight">In-House Facility<br/>Sharjah Al Dhaid</span>
        </div>
        <div class="h-6 w-px bg-white/15 hidden sm:block"></div>
        <div class="flex items-center gap-2">
          <span class="font-display text-xl font-bold text-canvas">24/7</span>
