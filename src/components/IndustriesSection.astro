---
import { industries } from '../data/industries';
---
<section id="industries" class="bg-cream py-20 px-6 sm:px-10 lg:px-16 relative overflow-hidden border-t border-hairline">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16" data-reveal="fade-up">
      <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-3">
        Industries We Serve
      </span>
      <h2 class="font-display text-3xl sm:text-4xl text-ink tracking-tight mb-4">
        Tailored Solutions for Every Setting
      </h2>
      <p class="font-body text-ink-soft text-base">
        From high-exposure international airports to prestigious luxury private villas and municipal educational campuses across the UAE.
      </p>
    </div>

    <!-- 6 Industries Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {industries.map((ind, idx) => (
        <div 
          class="bg-sand-soft rounded-2xl p-7 border border-hairline hover:border-primary/50 transition-all duration-300 shadow-sm hover:shadow-md group flex flex-col justify-between"
          data-reveal="fade-up"
          data-reveal-delay={String(idx * 0.08)}
        >
          <div>
            <!-- Icon Badge -->
            <div class="w-12 h-12 rounded-xl bg-canvas border border-hairline flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-canvas transition-colors mb-6 shadow-sm">
              {ind.id === 'education' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
              )}
              {ind.id === 'public-spaces' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              )}
              {ind.id === 'hospitality' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              )}
              {ind.id === 'residential' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              )}
              {ind.id === 'aviation' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              )}
              {ind.id === 'industrial-events' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              )}
            </div>

            <h3 class="font-body font-bold text-xl text-ink mb-2">{ind.title}</h3>
            <p class="font-body text-ink-soft text-sm leading-relaxed mb-6">
              {ind.description}
            </p>
          </div>

          <div class="pt-4 border-t border-hairline/80">
            <div class="font-mono text-[11px] text-ink-muted uppercase tracking-wider mb-2">Key Applications:</div>
            <ul class="space-y-1.5">
              {ind.applications.map(app => (
                <li class="text-xs font-body text-ink-soft flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-primary shrink-0"></span>
                  <span>{app}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
