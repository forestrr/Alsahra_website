---
import { industries } from '../data/industries';
---
<section id="industries" class="bg-navy-darker py-24 sm:py-32 px-6 sm:px-10 lg:px-16 relative overflow-hidden">
  <!-- Decorative glows -->
  <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="max-w-3xl mb-16" data-reveal="fade-up">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="w-12 h-[1px] bg-gold-accent"></span>
        <span class="text-gold-accent font-mono text-sm uppercase tracking-[0.2em] font-semibold">Industries We Serve</span>
      </div>
      <h2 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight mb-6">
        Tailored Solutions for Every Setting.
      </h2>
      <p class="font-body text-ink-secondary text-lg sm:text-xl leading-relaxed border-l-2 border-primary/30 pl-6 max-w-2xl">
        From high-exposure international airports to prestigious luxury private villas and municipal educational campuses across the UAE.
      </p>
    </div>

    <!-- Masonry/Bento Grid -->
    <div class="grid grid-cols-12 gap-6 sm:gap-8">
      {industries.map((ind, idx) => {
        // Create an asymmetrical layout map
        let spanClass = "col-span-12 sm:col-span-6 lg:col-span-4";
        if (idx === 0 || idx === 1) spanClass = "col-span-12 lg:col-span-6";
        else if (idx === 5) spanClass = "col-span-12";

        return (
          <div 
            class={`bg-navy-darker rounded-[32px] p-8 md:p-10 border border-white/10 hover:border-gold-accent/50 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-1 group relative overflow-hidden flex flex-col justify-between ${spanClass}`}
            data-reveal="fade-up"
            data-reveal-delay={String((idx % 3) * 0.1)}
          >
            <!-- Large Watermark Icon -->
            <div class="absolute -bottom-10 -right-10 opacity-5 text-white group-hover:text-gold-accent group-hover:opacity-10 group-hover:scale-110 transition-all duration-700 pointer-events-none w-72 h-72">
              {ind.id === 'education' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>}
              {ind.id === 'public-spaces' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>}
              {ind.id === 'hospitality' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>}
              {ind.id === 'residential' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>}
              {ind.id === 'aviation' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>}
              {ind.id === 'industrial-events' && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>}
            </div>

            <div class="relative z-10 mb-10">
              <h3 class="font-display font-bold text-2xl md:text-3xl text-white mb-4 group-hover:text-gold-accent transition-colors">{ind.title}</h3>
              <p class="font-body text-ink-secondary text-base leading-relaxed max-w-sm">
                {ind.description}
              </p>
            </div>

            <div class="relative z-10 pt-6 border-t border-white/10">
              <div class="font-mono text-xs text-gold-accent uppercase tracking-widest mb-4 font-semibold">Key Applications</div>
              <div class="flex flex-wrap gap-2">
                {ind.applications.map(app => (
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-body text-white/90 hover:bg-white/10 hover:border-gold-accent/30 transition-colors cursor-default">
                    {app}
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
