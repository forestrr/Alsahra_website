---
<footer class="bg-navy-darker pt-20 pb-10 px-6 sm:px-10 lg:px-16 border-t border-navy-mid text-canvas">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
    <!-- Brand Info (2 cols on lg) -->
    <div class="lg:col-span-2">
      <a href="#" class="inline-block mb-6">
        <img 
          src="/logo.png" 
          alt="Al Sahra Tents & Sheds Fix" 
          class="h-14 sm:h-16 w-auto object-contain brightness-0 invert" 
        />
      </a>
      <p class="font-body text-ink-secondary text-sm leading-relaxed mb-6 max-w-sm">
        Tents, tensile shade structures, and steel fabrication designed, built, and installed across the United Arab Emirates. Backed by our full in-house manufacturing facility in Sharjah Al Dhaid.
      </p>
      <div class="inline-flex items-center gap-2 bg-navy-card px-3 py-1.5 rounded-lg border border-white/10 text-xs font-mono text-gold-accent">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>Licensed UAE Contractor & Fabricator</span>
      </div>
    </div>
    
    <!-- Navigation Links -->
    <div>
      <h4 class="font-display font-bold text-canvas text-base mb-4 tracking-tight">Navigation</h4>
      <ul class="space-y-2.5 font-body text-sm text-ink-secondary">
        <li><a href="/#about" class="hover:text-gold-accent transition-colors">About Us</a></li>
        <li><a href="/#services" class="hover:text-gold-accent transition-colors">Services & Pillars</a></li>
        <li><a href="/#industries" class="hover:text-gold-accent transition-colors">Industries We Serve</a></li>
        <li><a href="/projects" class="hover:text-gold-accent transition-colors">Selected Projects</a></li>
        <li><a href="/trades" class="hover:text-gold-accent transition-colors">Our Trades & Panels</a></li>
        <li><a href="/#contact" class="hover:text-gold-accent transition-colors">Contact & Quote</a></li>
      </ul>
    </div>
    
    <!-- Solutions -->
    <div>
      <h4 class="font-display font-bold text-canvas text-base mb-4 tracking-tight">Capabilities</h4>
      <ul class="space-y-2.5 font-body text-sm text-ink-secondary">
        <li>Car Parking Shades</li>
        <li>Tensile Shade Structures</li>
        <li>Swimming Pool & Play Shades</li>
        <li>Customized Majlis Tents</li>
        <li>Retractable Pergolas</li>
        <li>Steel Warehouses & Sheds</li>
        <li>Mezzanines & Staircases</li>
        <li>Insulated Partition Panels</li>
      </ul>
    </div>
    
    <!-- Contact Info -->
    <div>
      <h4 class="font-display font-bold text-canvas text-base mb-4 tracking-tight">Official Contact</h4>
      <ul class="space-y-3 font-body text-sm text-ink-secondary">
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-gold-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Sharjah Al Dhaid, United Arab Emirates</span>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <div class="flex flex-col font-mono text-xs">
            <a href="tel:+971505077179" class="hover:text-gold-accent transition-colors">+971 50 507 7179</a>
            <a href="tel:+97165431993" class="hover:text-gold-accent transition-colors">+971 6 543 1993</a>
          </div>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-canvas shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <div class="flex flex-col font-mono text-xs">
            <a href="mailto:info@alsahratents.biz" class="hover:text-gold-accent transition-colors">info@alsahratents.biz</a>
            <a href="https://www.alsahratents.biz" target="_blank" class="text-primary-soft hover:underline">www.alsahratents.biz</a>
          </div>
        </li>
      </ul>
    </div>
  </div>
  
  <!-- Bottom Copyright Bar -->
  <div class="max-w-7xl mx-auto pt-8 border-t border-navy-mid flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-body text-ink-muted">
    <p>
      &copy; {new Date().getFullYear()} Al Sahra Tents & Sheds Fix. All Rights Reserved. Sharjah Al Dhaid, U.A.E.
    </p>
    <div class="flex items-center gap-6">
      <a href="/#about" class="hover:text-canvas transition-colors">Company Profile</a>
      <a href="/trades" class="hover:text-canvas transition-colors">Trading & Material Supply</a>
      <a href="/#contact" class="hover:text-canvas transition-colors">Request a Quote</a>
    </div>
  </div>
</footer>
