---
---
<section class="bg-navy-canvas py-24 px-6 sm:px-10 lg:px-16 border-t border-navy-mid relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <!-- Why Al Sahra Header (Page 10) -->
    <div class="max-w-3xl mb-16" data-reveal="fade-up">
      <span class="font-mono text-gold-accent text-xs uppercase tracking-[2px] font-semibold block mb-4">
        Why Al Sahra
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-[46px] leading-tight text-canvas mb-4">
        Strengths that set us apart
      </h2>
      <p class="font-body text-ink-secondary text-base sm:text-lg">
        UAE-based presence in Sharjah Al Dhaid — capable of supporting both small and large projects through internal resources and international alliances.
      </p>
    </div>

    <!-- 4 Strengths Grid (Page 10) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
      <!-- 01 -->
      <div class="bg-navy-darker p-7 rounded-2xl border border-navy-mid hover:border-gold-accent/40 transition-colors group shadow-lg" data-reveal="fade-up" data-reveal-delay="0.05">
        <div class="font-display text-gold-accent text-3xl font-bold mb-4">01</div>
        <h3 class="font-body font-bold text-canvas text-lg mb-2 group-hover:text-gold-accent transition-colors">One-Stop Service Model</h3>
        <p class="font-body text-ink-secondary text-sm leading-relaxed">
          Design, fabrication, installation, and ongoing maintenance fully coordinated under one roof.
        </p>
      </div>

      <!-- 02 -->
      <div class="bg-navy-darker p-7 rounded-2xl border border-navy-mid hover:border-gold-accent/40 transition-colors group shadow-lg" data-reveal="fade-up" data-reveal-delay="0.1">
        <div class="font-display text-gold-accent text-3xl font-bold mb-4">02</div>
        <h3 class="font-body font-bold text-canvas text-lg mb-2 group-hover:text-gold-accent transition-colors">Membrane & Steel Expertise</h3>
        <p class="font-body text-ink-secondary text-sm leading-relaxed">
          Proven dual technical capability spanning both architectural fabric membranes and heavy structural steel.
        </p>
      </div>

      <!-- 03 -->
      <div class="bg-navy-darker p-7 rounded-2xl border border-navy-mid hover:border-gold-accent/40 transition-colors group shadow-lg" data-reveal="fade-up" data-reveal-delay="0.15">
        <div class="font-display text-gold-accent text-3xl font-bold mb-4">03</div>
        <h3 class="font-body font-bold text-canvas text-lg mb-2 group-hover:text-gold-accent transition-colors">Built-to-Order Customization</h3>
        <p class="font-body text-ink-secondary text-sm leading-relaxed">
          Every product tailored to client briefs and project site parameters — never rigid cookie-cutter templates.
        </p>
      </div>

      <!-- 04 -->
      <div class="bg-navy-darker p-7 rounded-2xl border border-navy-mid hover:border-gold-accent/40 transition-colors group shadow-lg" data-reveal="fade-up" data-reveal-delay="0.2">
        <div class="font-display text-gold-accent text-3xl font-bold mb-4">04</div>
        <h3 class="font-body font-bold text-canvas text-lg mb-2 group-hover:text-gold-accent transition-colors">Quality & Realistic Pricing</h3>
        <p class="font-body text-ink-secondary text-sm leading-relaxed">
          Reliable service and quality-focused execution at practical, direct-manufacturer pricing across the UAE.
        </p>
      </div>
    </div>

    <!-- Process Timeline -->
    <div class="pt-16 border-t border-navy-mid" data-reveal="fade-up">
      <div class="mb-12">
        <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-2">Our Process</span>
        <h3 class="font-display text-2xl sm:text-3xl text-canvas">
          From first brief to ongoing lifecycle care
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="relative bg-navy-card/60 p-5 rounded-xl border border-white/5">
          <div class="font-mono text-xs text-primary font-bold mb-2">STEP 01</div>
          <h4 class="font-body font-semibold text-canvas text-base mb-1">Site & Engineering</h4>
          <p class="font-body text-ink-secondary text-xs">Site inspection, 3D modelling, wind load calculation & custom design.</p>
        </div>
        <div class="relative bg-navy-card/60 p-5 rounded-xl border border-white/5">
          <div class="font-mono text-xs text-primary font-bold mb-2">STEP 02</div>
          <h4 class="font-body font-semibold text-canvas text-base mb-1">In-House Forging</h4>
          <p class="font-body text-ink-secondary text-xs">Precision steel cutting, welding, primer coating & fabric patterning.</p>
        </div>
        <div class="relative bg-navy-card/60 p-5 rounded-xl border border-white/5">
          <div class="font-mono text-xs text-primary font-bold mb-2">STEP 03</div>
          <h4 class="font-body font-semibold text-canvas text-base mb-1">Site Installation</h4>
          <p class="font-body text-ink-secondary text-xs">Certified site teams handle foundation anchor bolts, erection & tensioning.</p>
        </div>
        <div class="relative bg-navy-card/60 p-5 rounded-xl border border-white/5">
          <div class="font-mono text-xs text-primary font-bold mb-2">STEP 04</div>
          <h4 class="font-body font-semibold text-canvas text-base mb-1">Inspection & Signoff</h4>
          <p class="font-body text-ink-secondary text-xs">Tension testing, safety verification, and formal client handover.</p>
        </div>
        <div class="relative bg-navy-card/60 p-5 rounded-xl border border-white/5">
          <div class="font-mono text-xs text-primary font-bold mb-2">STEP 05</div>
          <h4 class="font-body font-semibold text-canvas text-base mb-1">Fix & Renovation</h4>
          <p class="font-body text-ink-secondary text-xs">Ongoing preventive maintenance, fabric replacement & re-tensioning.</p>
        </div>
      </div>
    </div>
  </div>
</section>
