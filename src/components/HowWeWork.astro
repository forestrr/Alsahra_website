---
const processSteps = [
  {
    step: "01",
    phase: "Phase 01",
    title: "Site Survey & 3D Design",
    subtitle: "Custom Engineering",
    description: "Our engineers inspect the site, calculate wind loads to UAE municipality standards, and generate precise 3D structural and membrane models.",
    image: "/images/process_step1_survey.jpg",
    tag: "Design & Calculation",
    specs: "3D CAD • Wind Load Codes",
    metric: "100% Tailored Specs"
  },
  {
    step: "02",
    phase: "Phase 02",
    title: "In-House Forging",
    subtitle: "Sharjah Al Dhaid Workshop",
    description: "Precision CNC cutting, certified welding, sandblasting, primer coating, and automated patterning of international HDPE/PVC membranes.",
    image: "/images/process_step2_forging.jpg",
    tag: "In-House Fabrication",
    specs: "CNC Cutting • Certified Welding",
    metric: "Zero Subcontracting"
  },
  {
    step: "03",
    phase: "Phase 03",
    title: "Foundation & Erection",
    subtitle: "Certified Rigging Teams",
    description: "Cast-in-place anchor bolts, crane erection of structural steel columns, and hydraulic tensioning of architectural cable membranes.",
    image: "/images/process_step3_foundation.png",
    tag: "Site Installation",
    specs: "Hydraulic Tensioning • Crane Crews",
    metric: "UAE Safety Certified"
  },
  {
    step: "04",
    phase: "Phase 04",
    title: "Testing & Handover",
    subtitle: "Quality Certification",
    description: "Rigorous tension testing, weld integrity checks, weather-tightness verification, and formal municipal authority signoff documentation.",
    image: "/images/process_step4_testing.png",
    tag: "Quality Handover",
    specs: "Tension Testing • Municipality Signoff",
    metric: "Full Warranty Pack"
  },
  {
    step: "05",
    phase: "Phase 05",
    title: "Care, Fix & Renovation",
    subtitle: "Full Lifecycle Support",
    description: "Scheduled preventive maintenance, fabric re-tensioning, UV protection inspections, and renovation of existing structures across UAE.",
    image: "/images/process_step5_maintenance.jpg",
    tag: "Ongoing Support",
    specs: "Re-tensioning • Rapid Repairs",
    metric: "24/7 Response Across UAE"
  }
];
---
<section id="process" class="bg-navy-canvas py-24 px-4 sm:px-8 lg:px-16 border-t border-navy-mid relative overflow-hidden">
  <!-- Subtle ambient background glow orbs -->
  <div class="absolute top-1/4 left-1/5 w-[550px] h-[550px] bg-primary/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/5 w-[550px] h-[550px] bg-gold-accent/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Why Al Sahra Section Header (Page 10 of Profile) -->
    <div class="max-w-3xl mb-16" data-reveal="fade-up">
      <div class="inline-flex items-center gap-2 bg-navy-mid/60 px-3 py-1 rounded-full border border-navy-border text-gold-accent font-mono text-xs uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-accent animate-ping"></span>
        <span>Why Al Sahra</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-[46px] leading-tight text-canvas mb-4">
        Strengths that set us apart
      </h2>
      <p class="font-body text-ink-secondary text-base sm:text-lg">
        UAE-based presence in Sharjah Al Dhaid — capable of supporting both small and large projects through internal resources and international alliances.
      </p>
    </div>

    <!-- Asymmetrical Bento Grid (Why Al Sahra) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-6 mb-24">
      
      <!-- Card 01: Large Hero Block (Spans 7 cols) -->
      <div class="lg:col-span-7 bg-navy-darker rounded-[32px] p-8 md:p-10 border border-navy-mid/80 hover:border-primary/50 transition-all duration-500 group shadow-2xl relative overflow-hidden" data-reveal="fade-up" data-reveal-delay="0.05">
        <!-- Subtle radial glow background -->
        <div class="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-primary/10 via-transparent to-transparent opacity-50 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
        
        <!-- Large Watermark Number -->
        <div class="absolute -bottom-6 -right-4 font-display font-black text-[140px] md:text-[180px] leading-none text-navy-canvas/50 select-none z-0 group-hover:scale-105 group-hover:-translate-x-2 transition-transform duration-700">01</div>
        
        <div class="relative z-10 h-full flex flex-col justify-end min-h-[220px]">
          <h3 class="font-body font-bold text-canvas text-2xl md:text-3xl mb-4 group-hover:text-primary transition-colors duration-300 max-w-sm">One-Stop Service Model</h3>
          <p class="font-body text-ink-secondary text-base md:text-lg leading-relaxed max-w-md">
            Design, fabrication, installation, and maintenance fully coordinated under one roof in our Sharjah facility.
          </p>
        </div>
      </div>

      <!-- Card 02: Compact Block (Spans 5 cols) -->
      <div class="lg:col-span-5 bg-navy-darker rounded-[32px] p-8 md:p-10 border border-navy-mid/80 hover:border-gold-accent/50 transition-all duration-500 group shadow-xl relative overflow-hidden flex flex-col justify-between" data-reveal="fade-up" data-reveal-delay="0.1">
        <!-- Large Watermark Number -->
        <div class="absolute -top-4 -right-4 font-display font-black text-[100px] md:text-[120px] leading-none text-navy-canvas/50 select-none z-0 group-hover:scale-105 group-hover:translate-y-2 transition-transform duration-700">02</div>
        
        <div class="relative z-10 mb-6 md:mb-8 mt-10 md:mt-12">
          <h3 class="font-body font-bold text-canvas text-xl md:text-2xl mb-3 group-hover:text-gold-accent transition-colors duration-300 max-w-[200px]">Membrane & Steel Expertise</h3>
          <p class="font-body text-ink-secondary text-sm md:text-base leading-relaxed">
            Proven dual capability across architectural fabric tensile systems and heavy structural steel.
          </p>
        </div>
      </div>

      <!-- Card 03: Compact Block (Spans 5 cols) -->
      <div class="lg:col-span-5 bg-navy-darker rounded-[32px] p-8 md:p-10 border border-navy-mid/80 hover:border-gold-accent/50 transition-all duration-500 group shadow-xl relative overflow-hidden" data-reveal="fade-up" data-reveal-delay="0.15">
         <!-- Large Watermark Number -->
         <div class="absolute -bottom-6 -left-4 font-display font-black text-[100px] md:text-[120px] leading-none text-navy-canvas/50 select-none z-0 group-hover:scale-105 group-hover:translate-x-2 transition-transform duration-700">03</div>
        
         <div class="relative z-10 md:text-right h-full flex flex-col justify-center min-h-[160px]">
          <h3 class="font-body font-bold text-canvas text-xl md:text-2xl mb-3 group-hover:text-gold-accent transition-colors duration-300">Built-to-Order Customization</h3>
          <p class="font-body text-ink-secondary text-sm md:text-base leading-relaxed md:ml-auto md:max-w-[240px]">
            Every product tailored to client brief and site parameters — never rigid cookie-cutter templates.
          </p>
        </div>
      </div>

      <!-- Card 04: Wide Footer Block (Spans 7 cols) -->
      <div class="lg:col-span-7 bg-navy-darker rounded-[32px] p-8 md:p-10 border border-navy-mid/80 hover:border-white/30 transition-all duration-500 group shadow-xl relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6" data-reveal="fade-up" data-reveal-delay="0.2">
        <!-- Large Watermark Number -->
        <div class="absolute -bottom-8 -right-4 md:right-16 font-display font-black text-[120px] md:text-[160px] leading-none text-navy-canvas/50 select-none z-0 group-hover:scale-105 group-hover:-translate-x-2 transition-transform duration-700">04</div>
        
        <div class="relative z-10 w-full">
          <h3 class="font-body font-bold text-canvas text-xl md:text-2xl mb-3 group-hover:text-white transition-colors duration-300">Quality & Realistic Pricing</h3>
          <p class="font-body text-ink-secondary text-sm md:text-base leading-relaxed max-w-lg">
            Reliable service and quality-focused execution at practical, direct-manufacturer pricing across the UAE.
          </p>
        </div>
        <!-- Decorative graphic element -->
        <div class="w-12 h-12 md:w-16 md:h-16 shrink-0 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white/5 transition-colors duration-500 self-end md:self-auto">
           <svg class="w-5 h-5 md:w-6 md:h-6 text-white/50 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
      </div>

    </div>

    <!-- ================================================================= -->
    <!-- ANIMATED CONNECTED PROCESS TIMELINE (HYPERFRAMES PROGRESS ENGINE) -->
    <!-- ================================================================= -->
    <div id="process-timeline-container" class="pt-16 border-t border-navy-mid relative scroll-mt-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6" data-reveal="fade-up">
        <div class="max-w-2xl">
          <span class="font-mono text-primary text-xs uppercase tracking-[2px] font-semibold block mb-2">
            Interactive Engineering Flow
          </span>
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-canvas tracking-tight">
            Connected Step-by-Step Execution
          </h3>
          <p class="font-body text-ink-secondary text-sm sm:text-base mt-2">
            Scroll down or up to drive the progress line through every stage of construction. Click or hover any step to inspect details.
          </p>
        </div>

        <!-- Interactive Milestone Filter / Scrubber Tabs -->
        <div class="flex flex-wrap items-center gap-1.5 p-1.5 bg-navy-darker rounded-xl border border-navy-border self-start md:self-auto shadow-lg">
          {processSteps.map((step, idx) => (
            <button
              type="button"
              class="process-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium text-ink-secondary hover:text-canvas hover:bg-navy-mid/60 transition-all duration-200 flex items-center gap-1.5 cursor-pointer"
              data-tab-index={idx}
            >
              <span class="tab-number text-primary font-bold">{step.step}</span>
              <span class="hidden sm:inline">{step.title.split(' ')[0]}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- DESKTOP TIMELINE (Visible on lg screens) -->
      <div id="desktop-timeline-wrapper" class="hidden lg:block relative mb-16 pt-8">
        <!-- Connecting Line Background Track (spans exactly between first and last node centers) -->
        <div 
          id="process-track-bg"
          class="absolute top-[60px] -translate-y-1/2 h-[4px] bg-navy-mid/80 rounded-full z-0 overflow-hidden pointer-events-none"
        >
          <div class="w-full h-full bg-gradient-to-r from-navy-border/40 via-white/10 to-navy-border/40"></div>
        </div>

        <!-- Animated Progress Connecting Line (Bidirectional Dynamic Scrub) -->
        <div 
          id="process-progress-line" 
          class="absolute top-[60px] -translate-y-1/2 h-[4px] bg-gradient-to-r from-primary via-primary-light to-gold-accent rounded-full z-0 transition-all duration-300 ease-out shadow-[0_0_14px_rgba(46,139,87,0.9)] pointer-events-none"
          style="left: 10%; width: 0%;"
        ></div>

        <!-- 5 Steps Horizontal Grid -->
        <div class="grid grid-cols-5 gap-4 relative z-10" id="desktop-steps-grid">
          {processSteps.map((step, idx) => (
            <div 
              class="process-step-node flex flex-col items-center group cursor-pointer transition-all duration-300"
              data-step-index={idx}
            >
              <!-- Step Circle Node on the Line -->
              <div 
                class="process-node-circle w-14 h-14 rounded-full bg-navy-darker border-2 border-navy-mid flex items-center justify-center font-display font-black text-lg transition-all duration-300 group-hover:scale-110 mb-6 shadow-xl relative select-none z-10"
              >
                <!-- Number Text: always visible, on top, with high contrast -->
                <span class="step-num-text relative z-30 font-display font-black text-base transition-all duration-300 select-none text-ink-muted">
                  {step.step}
                </span>

                <!-- Expanding Ring Animation on Active Step (Outward ping ring, never covers digits) -->
                <span class="pulse-ring absolute -inset-1 rounded-full border-2 border-gold-accent opacity-0 pointer-events-none transition-all duration-300 z-10"></span>

                <!-- Active Status Badge -->
                <span class="active-badge absolute -top-3.5 px-2.5 py-0.5 rounded-full bg-gold-accent text-navy-darker text-[9px] font-mono font-black uppercase tracking-wider opacity-0 transition-all duration-300 shadow-md pointer-events-none z-30">
                  Active
                </span>
              </div>

              <!-- Step Card with Aesthetic Picture -->
              <div class="process-card w-full bg-navy-card rounded-2xl overflow-hidden border border-navy-border group-hover:border-primary/60 transition-all duration-400 flex flex-col shadow-lg group-hover:-translate-y-2 group-hover:shadow-[0_12px_30px_rgba(0,0,0,0.5)]">
                <!-- Aesthetic Picture Frame -->
                <div class="relative aspect-[16/10] overflow-hidden bg-navy-darker">
                  <img 
                    src={step.image} 
                    alt={step.title} 
                    class="process-card-img w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy-card via-transparent to-transparent opacity-70"></div>
                  
                  <!-- Phase Tag -->
                  <span class="absolute top-2.5 left-2.5 text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-navy-darker/90 text-gold-accent border border-white/10 shadow-sm">
                    {step.phase}
                  </span>

                  <!-- Metric Pill -->
                  <span class="card-metric absolute bottom-2 left-2.5 right-2.5 text-[9px] font-mono text-canvas bg-navy-darker/80 backdrop-blur-xs px-2 py-0.5 rounded truncate border border-white/5 opacity-80 group-hover:opacity-100 transition-opacity">
                    {step.metric}
                  </span>
                </div>

                <!-- Text Content -->
                <div class="p-4 flex-1 flex flex-col justify-between">
                  <div>
                    <h4 class="card-title font-body font-bold text-sm text-canvas group-hover:text-gold-accent transition-colors mb-1">
                      {step.title}
                    </h4>
                    <p class="font-mono text-[10px] text-primary font-medium mb-2">
                      {step.subtitle}
                    </p>
                    <p class="font-body text-ink-secondary text-xs leading-relaxed line-clamp-3">
                      {step.description}
                    </p>
                  </div>

                  <div class="mt-3 pt-3 border-t border-navy-mid/60 text-[10px] font-mono text-ink-muted group-hover:text-ink-secondary transition-colors">
                    {step.specs}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- MOBILE & TABLET TIMELINE (Vertical Connected Spine with Scroll-Linked Draw) -->
      <div class="lg:hidden relative pl-8 sm:pl-10 space-y-8 my-8">
        <!-- Vertical Connecting Track -->
        <div class="absolute top-4 bottom-4 left-[15px] sm:left-[19px] w-[3px] bg-navy-mid/70 rounded-full"></div>
        
        <!-- Vertical Progress Fill Line -->
        <div 
          id="process-mobile-progress-line" 
          class="absolute top-4 left-[15px] sm:left-[19px] w-[3px] bg-gradient-to-b from-primary via-primary-light to-gold-accent rounded-full transition-all duration-300 shadow-[0_0_10px_rgba(46,139,87,0.7)]"
          style="height: 0%;"
        ></div>

        {processSteps.map((step, idx) => (
          <div 
            class="process-mobile-step relative cursor-pointer"
            data-step-index={idx}
          >
            <!-- Step Node on Spine -->
            <div class="mobile-node-circle absolute -left-[30px] sm:-left-[34px] top-4 w-8 h-8 rounded-full bg-navy-darker border-2 border-navy-mid text-ink-muted flex items-center justify-center font-display font-bold text-xs shadow-lg z-10 transition-all duration-300">
              {step.step}
            </div>

            <!-- Mobile Card with Picture -->
            <div class="mobile-card bg-navy-card rounded-2xl overflow-hidden border border-navy-border shadow-xl transition-all duration-300">
              <div class="relative aspect-[16/9] overflow-hidden bg-navy-darker">
                <img 
                  src={step.image} 
                  alt={step.title} 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-card via-transparent to-transparent opacity-70"></div>
                <span class="absolute top-3 left-3 text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-navy-darker/85 text-gold-accent border border-white/10">
                  {step.phase}
                </span>
                <span class="absolute bottom-3 left-3 text-[10px] font-mono text-canvas bg-navy-darker/80 px-2 py-0.5 rounded border border-white/10">
                  {step.metric}
                </span>
              </div>
              <div class="p-5">
                <div class="font-mono text-xs text-primary font-semibold mb-1">{step.subtitle}</div>
                <h4 class="font-body font-bold text-lg text-canvas mb-2">{step.title}</h4>
                <p class="font-body text-ink-secondary text-sm leading-relaxed mb-3">{step.description}</p>
                <div class="text-xs font-mono text-ink-muted pt-3 border-t border-navy-mid/60">
                  Specification: {step.specs}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Interactive Status Banner -->
      <div id="process-active-status" class="mt-8 p-4 rounded-xl bg-navy-darker/90 border border-navy-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-ink-secondary">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
          <span class="text-canvas font-semibold">Active Milestone:</span>
          <span id="active-step-label" class="text-gold-accent font-bold">Phase 01: Site Survey & 3D Design</span>
        </div>
        <div class="text-ink-muted text-[11px]">
          Sharjah Al Dhaid In-House Fabrication Facility • Serving All 7 UAE Emirates
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================================================================= -->
<!-- BIDIRECTIONAL SCROLL & INTERACTIVE STEP ENGINE -->
<!-- ================================================================= -->
<script>
  function initInteractiveProcess() {
    const container = document.getElementById('process-timeline-container');
    const wrapper = document.getElementById('desktop-timeline-wrapper');
    const trackBg = document.getElementById('process-track-bg');
    const desktopLine = document.getElementById('process-progress-line');
    const mobileLine = document.getElementById('process-mobile-progress-line');
    const nodes = document.querySelectorAll<HTMLElement>('.process-step-node');
    const mobileSteps = document.querySelectorAll<HTMLElement>('.process-mobile-step');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.process-tab-btn');
    const activeLabel = document.getElementById('active-step-label');

    if (!container || !wrapper || nodes.length === 0) return;

    const stepTitles = [
      "Phase 01: Site Survey & 3D Wind Analysis",
      "Phase 02: Sharjah In-House CNC Forging",
      "Phase 03: Certified Crane Erection & Rigging",
      "Phase 04: Tension Testing & Municipality Signoff",
      "Phase 05: 24/7 Care, Fix & Renovation"
    ];

    let stepCenters: number[] = [];
    let activeStepIdx = 0;
    let isHoverLocked = false;
    let hoverUnlockTimeout: number | null = null;

    // Calculate exact pixel centers of each desktop circle node relative to wrapper
    function updateDesktopGeometry() {
      if (!wrapper || !trackBg || nodes.length === 0) return;
      const wrapperRect = wrapper.getBoundingClientRect();
      stepCenters = [];

      nodes.forEach((node) => {
        const circle = node.querySelector<HTMLElement>('.process-node-circle');
        if (circle) {
          const circleRect = circle.getBoundingClientRect();
          const centerPx = (circleRect.left + circleRect.width / 2) - wrapperRect.left;
          stepCenters.push(centerPx);
        }
      });

      if (stepCenters.length >= 2) {
        const firstCenter = stepCenters[0];
        const lastCenter = stepCenters[stepCenters.length - 1];
        trackBg.style.left = `${firstCenter}px`;
        trackBg.style.width = `${lastCenter - firstCenter}px`;
      }
    }

    function setActiveStep(idx: number, animateBeam = true) {
      if (idx < 0) idx = 0;
      if (idx > 4) idx = 4;
      activeStepIdx = idx;

      // Update active banner label
      if (activeLabel && stepTitles[idx]) {
        activeLabel.textContent = stepTitles[idx];
      }

      // Update Desktop Tabs
      tabBtns.forEach((btn, i) => {
        if (i === idx) {
          btn.classList.add('bg-primary/20', 'text-canvas', 'border', 'border-primary/40');
          btn.classList.remove('text-ink-secondary');
        } else {
          btn.classList.remove('bg-primary/20', 'text-canvas', 'border', 'border-primary/40');
          btn.classList.add('text-ink-secondary');
        }
      });

      // Update Desktop Nodes and Cards
      nodes.forEach((node, i) => {
        const circle = node.querySelector<HTMLElement>('.process-node-circle');
        const numText = node.querySelector<HTMLElement>('.step-num-text');
        const ring = node.querySelector<HTMLElement>('.pulse-ring');
        const activeBadge = node.querySelector<HTMLElement>('.active-badge');
        const card = node.querySelector<HTMLElement>('.process-card');
        const img = node.querySelector<HTMLElement>('.process-card-img');

        if (i === idx) {
          // CURRENT ACTIVE STEP: Glowing ring, gold border, highly visible crisp number
          if (circle) {
            circle.className = 'process-node-circle w-14 h-14 rounded-full bg-navy-darker border-2 border-gold-accent flex items-center justify-center font-display font-black text-lg transition-all duration-300 group-hover:scale-110 mb-6 shadow-[0_0_24px_rgba(212,167,44,0.7)] ring-4 ring-gold-accent/20 relative select-none z-20 scale-115';
          }
          if (numText) {
            numText.className = 'step-num-text relative z-30 font-display font-black text-lg text-gold-accent scale-110 drop-shadow-[0_0_10px_rgba(212,167,44,0.9)] transition-all duration-300 select-none';
          }
          if (ring) {
            ring.className = 'pulse-ring absolute -inset-1.5 rounded-full border-2 border-gold-accent opacity-100 animate-ping pointer-events-none transition-all duration-300 z-10';
          }
          if (activeBadge) {
            activeBadge.className = 'active-badge absolute -top-3.5 px-2.5 py-0.5 rounded-full bg-gold-accent text-navy-darker text-[9px] font-mono font-black uppercase tracking-wider opacity-100 scale-100 transition-all duration-300 shadow-md pointer-events-none z-30';
          }
          if (card) {
            card.classList.add('border-gold-accent/80', '-translate-y-3', 'shadow-[0_15px_35px_rgba(0,0,0,0.6)]', 'ring-1', 'ring-gold-accent/30');
          }
          if (img) {
            img.classList.add('scale-108');
          }
        } else if (i < idx) {
          // COMPLETED / CONNECTED STEPS
          if (circle) {
            circle.className = 'process-node-circle w-14 h-14 rounded-full bg-navy-darker border-2 border-primary flex items-center justify-center font-display font-bold text-base transition-all duration-300 group-hover:scale-110 mb-6 shadow-[0_0_12px_rgba(30,112,68,0.4)] relative select-none z-10';
          }
          if (numText) {
            numText.className = 'step-num-text relative z-30 font-display font-bold text-base text-emerald-300 transition-all duration-300 select-none';
          }
          if (ring) {
            ring.className = 'pulse-ring absolute -inset-1 rounded-full border-2 border-primary opacity-0 pointer-events-none transition-all duration-300 z-10';
          }
          if (activeBadge) {
            activeBadge.className = 'active-badge absolute -top-3.5 px-2.5 py-0.5 rounded-full bg-gold-accent text-navy-darker text-[9px] font-mono font-black uppercase tracking-wider opacity-0 scale-90 transition-all duration-300 shadow-md pointer-events-none z-30';
          }
          if (card) {
            card.classList.remove('border-gold-accent/80', '-translate-y-3', 'shadow-[0_15px_35px_rgba(0,0,0,0.6)]', 'ring-1', 'ring-gold-accent/30');
          }
          if (img) {
            img.classList.remove('scale-108');
          }
        } else {
          // FUTURE / UPCOMING STEPS
          if (circle) {
            circle.className = 'process-node-circle w-14 h-14 rounded-full bg-navy-darker border-2 border-navy-mid flex items-center justify-center font-display font-bold text-base transition-all duration-300 group-hover:scale-110 mb-6 shadow-md relative select-none z-10';
          }
          if (numText) {
            numText.className = 'step-num-text relative z-30 font-display font-semibold text-base text-ink-muted/80 transition-all duration-300 select-none';
          }
          if (ring) {
            ring.className = 'pulse-ring absolute -inset-1 rounded-full border-2 border-primary opacity-0 pointer-events-none transition-all duration-300 z-10';
          }
          if (activeBadge) {
            activeBadge.className = 'active-badge absolute -top-3.5 px-2.5 py-0.5 rounded-full bg-gold-accent text-navy-darker text-[9px] font-mono font-black uppercase tracking-wider opacity-0 scale-90 transition-all duration-300 shadow-md pointer-events-none z-30';
          }
          if (card) {
            card.classList.remove('border-gold-accent/80', '-translate-y-3', 'shadow-[0_15px_35px_rgba(0,0,0,0.6)]', 'ring-1', 'ring-gold-accent/30');
          }
          if (img) {
            img.classList.remove('scale-108');
          }
        }
      });

      // Update Mobile Steps
      mobileSteps.forEach((mStep, i) => {
        const mCircle = mStep.querySelector('.mobile-node-circle');
        const mCard = mStep.querySelector('.mobile-card');
        if (i <= idx) {
          if (mCircle) {
            mCircle.classList.remove('border-navy-mid', 'text-ink-muted');
            mCircle.classList.add('border-primary', 'bg-primary/20', 'text-canvas');
          }
        } else {
          if (mCircle) {
            mCircle.classList.remove('border-primary', 'bg-primary/20', 'text-canvas', 'border-gold-accent');
            mCircle.classList.add('border-navy-mid', 'text-ink-muted');
          }
        }

        if (i === idx) {
          if (mCircle) {
            mCircle.classList.add('border-gold-accent', 'scale-110', 'shadow-gold-accent/50');
          }
          if (mCard) {
            mCard.classList.add('border-gold-accent/70', 'shadow-xl');
          }
        } else {
          if (mCircle) {
            mCircle.classList.remove('border-gold-accent', 'scale-110', 'shadow-gold-accent/50');
          }
          if (mCard) {
            mCard.classList.remove('border-gold-accent/70', 'shadow-xl');
          }
        }
      });

      // Position Desktop Beam exactly to the active node center
      if (animateBeam && desktopLine && stepCenters.length >= 5) {
        const startX = stepCenters[0];
        const targetX = stepCenters[idx];
        desktopLine.style.left = `${startX}px`;
        desktopLine.style.width = `${Math.max(0, targetX - startX)}px`;
      }
    }

    // Interactive Hover & Click Listeners
    nodes.forEach((node, idx) => {
      node.addEventListener('mouseenter', () => {
        isHoverLocked = true;
        if (hoverUnlockTimeout) clearTimeout(hoverUnlockTimeout);
        setActiveStep(idx, true);
      });

      node.addEventListener('mouseleave', () => {
        hoverUnlockTimeout = window.setTimeout(() => {
          isHoverLocked = false;
          handleScroll();
        }, 1200);
      });

      node.addEventListener('click', () => {
        isHoverLocked = true;
        setActiveStep(idx, true);
        if (hoverUnlockTimeout) clearTimeout(hoverUnlockTimeout);
        hoverUnlockTimeout = window.setTimeout(() => {
          isHoverLocked = false;
        }, 2500);
      });
    });

    // Milestone Tab Buttons Click
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-tab-index') || '0', 10);
        isHoverLocked = true;
        setActiveStep(idx, true);
        if (hoverUnlockTimeout) clearTimeout(hoverUnlockTimeout);
        hoverUnlockTimeout = window.setTimeout(() => {
          isHoverLocked = false;
        }, 3000);
      });
    });

    // Mobile Step Click
    mobileSteps.forEach((mStep, idx) => {
      mStep.addEventListener('click', () => {
        setActiveStep(idx, false);
      });
    });

    // Scroll-Linked Update
    let ticking = false;

    function handleScroll() {
      if (isHoverLocked) return;

      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.bottom < 0 || rect.top > windowHeight) {
        return;
      }

      const startPoint = windowHeight * 0.75;
      const endPoint = windowHeight * 0.25;
      const scrollableRange = rect.height + (startPoint - endPoint);
      const scrolledDist = startPoint - rect.top;

      let progress = scrolledDist / scrollableRange;
      progress = Math.max(0, Math.min(progress, 1));

      // 1. DESKTOP ANIMATION UPDATE (Exact pixel-mapped connecting beam)
      if (desktopLine && stepCenters.length >= 5) {
        const startX = stepCenters[0];
        const endX = stepCenters[4];
        const totalSpan = endX - startX;
        const currentWidth = progress * totalSpan;

        desktopLine.style.left = `${startX}px`;
        desktopLine.style.width = `${currentWidth}px`;

        // Determine active step based on progress thresholds
        let currentStep = 0;
        if (progress >= 0.85) {
          currentStep = 4;
        } else if (progress >= 0.65) {
          currentStep = 3;
        } else if (progress >= 0.42) {
          currentStep = 2;
        } else if (progress >= 0.20) {
          currentStep = 1;
        } else {
          currentStep = 0;
        }

        setActiveStep(currentStep, false);
      }

      // 2. MOBILE ANIMATION UPDATE
      if (mobileLine) {
        const mobileHeightPercent = progress * 96;
        mobileLine.style.height = `${mobileHeightPercent}%`;
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      updateDesktopGeometry();
      setActiveStep(activeStepIdx, true);
    });

    // Initial setup on mount
    updateDesktopGeometry();
    setActiveStep(0, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveProcess);
  } else {
    initInteractiveProcess();
  }
</script>

