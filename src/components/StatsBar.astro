---
---
<section class="bg-sand-soft py-14 px-6 md:px-16 border-y border-hairline relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <!-- Header tag -->
    <div class="text-center mb-10" data-reveal="fade-up">
      <span class="font-mono text-primary text-xs font-semibold uppercase tracking-[2px] block mb-2">By The Numbers</span>
      <h2 class="font-display font-medium text-2xl md:text-3xl text-ink">
        Trusted by customers across the UAE
      </h2>
    </div>

    <!-- 4-Stat Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <!-- Stat 1 -->
      <div class="text-center px-4 pt-4 md:pt-0" data-reveal="fade-up" data-reveal-delay="0.05">
        <div 
          class="font-display font-bold text-5xl md:text-6xl text-gold-accent mb-2 tracking-tight"
          data-counter-target="500" 
          data-counter-suffix="+"
        >
          0+
        </div>
        <div class="font-body font-semibold text-ink text-sm uppercase tracking-wider mb-1">Customers</div>
        <p class="font-body text-ink-muted text-xs">Served across public & private sectors</p>
      </div>

      <!-- Stat 2 -->
      <div class="text-center px-4 pt-4 md:pt-0" data-reveal="fade-up" data-reveal-delay="0.1">
        <div 
          class="font-display font-bold text-5xl md:text-6xl text-gold-accent mb-2 tracking-tight"
          data-counter-target="25" 
          data-counter-suffix="+"
        >
          0+
        </div>
        <div class="font-body font-semibold text-ink text-sm uppercase tracking-wider mb-1">Services</div>
        <p class="font-body text-ink-muted text-xs">Under one turnkey roof</p>
      </div>

      <!-- Stat 3 -->
      <div class="text-center px-4 pt-4 md:pt-0" data-reveal="fade-up" data-reveal-delay="0.15">
        <div 
          class="font-display font-bold text-5xl md:text-6xl text-gold-accent mb-2 tracking-tight"
          data-counter-target="15" 
          data-counter-suffix="+"
        >
          0+
        </div>
        <div class="font-body font-semibold text-ink text-sm uppercase tracking-wider mb-1">Skilled Staff</div>
        <p class="font-body text-ink-muted text-xs">Engineers & certified technicians</p>
      </div>

      <!-- Stat 4 -->
      <div class="text-center px-4 pt-4 md:pt-0" data-reveal="fade-up" data-reveal-delay="0.2">
        <div 
          class="font-display font-bold text-5xl md:text-6xl text-gold-accent mb-2 tracking-tight"
          data-counter-target="100" 
          data-counter-suffix="%"
        >
          0%
        </div>
        <div class="font-body font-semibold text-ink text-sm uppercase tracking-wider mb-1">In-House Made</div>
        <p class="font-body text-ink-muted text-xs">Sharjah Al Dhaid steel & fabric works</p>
      </div>
    </div>
  </div>
</section>
