---
---
<header class="sticky top-0 z-50 transition-all duration-300 bg-cream/95 backdrop-blur-md border-b border-hairline px-4 sm:px-8 lg:px-12 py-2 sm:py-2.5 flex items-center justify-between">
  <!-- Brand Logo (Compact & Sleek) -->
  <div class="flex items-center">
    <a href="/" aria-label="Al Sahra Tents & Sheds Fix" class="flex items-center gap-2 group py-0.5">
      <img 
        src="/logo.png" 
        alt="Al Sahra Tents & Sheds Fix" 
        class="h-9 sm:h-10 md:h-11 lg:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
      />
    </a>
  </div>
  
  <!-- Navigation Links with Animated Underlines -->
  <nav class="hidden md:flex gap-6 lg:gap-7 items-center">
    <a href="/#about" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300">
      About
    </a>
    <a href="/#services" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300">
      Services
    </a>
    <a href="/#industries" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300">
      Industries
    </a>
    <a href="/projects" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300">
      Projects
    </a>
    <a href="/trades" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors flex items-center gap-1.5 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300 group">
      <span>Our Trades</span>
      <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-primary/10 text-primary font-bold transition-transform duration-200 group-hover:scale-105">Panels</span>
    </a>
    <a href="/#contact" class="relative text-ink font-body font-medium text-[14px] lg:text-[15px] hover:text-primary transition-colors py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-primary hover:after:w-full after:transition-all after:duration-300">
      Contact
    </a>
  </nav>

  <!-- Right Actions -->
  <div class="flex items-center gap-3 sm:gap-5">
    <div class="hidden xl:flex flex-col items-end text-right">
      <a href="tel:+971505077179" class="text-ink font-mono text-xs font-semibold hover:text-primary transition-colors flex items-center gap-1.5 group">
        <svg class="w-3.5 h-3.5 text-primary group-hover:rotate-12 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>+971 50 507 7179</span>
      </a>
      <span class="text-[10px] text-ink-muted">Sharjah Al Dhaid, UAE</span>
    </div>

    <!-- Animated CTA Button with Shimmer and Motion -->
    <a 
      href="/#contact" 
      class="relative overflow-hidden group bg-primary hover:bg-primary-soft text-white font-body font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-primary/30 active:scale-95 flex items-center gap-1.5"
    >
      <!-- Shimmer effect sweep on hover -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out pointer-events-none"></span>
      
      <span class="relative z-10">Get Free Quote</span>
      <svg class="w-3.5 h-3.5 relative z-10 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      class="md:hidden p-1.5 rounded-lg text-ink hover:bg-sand transition-colors"
      aria-label="Toggle Navigation Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-navy-darker/70 backdrop-blur-sm hidden md:hidden">
  <div class="bg-cream w-4/5 max-w-sm h-full p-6 shadow-2xl flex flex-col justify-between overflow-y-auto">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-hairline">
        <img src="/logo.png" alt="Al Sahra" class="h-12 w-auto object-contain" />
        <button id="close-menu-btn" class="p-2 text-ink" aria-label="Close Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="flex flex-col gap-4 py-6 font-body text-base text-ink font-medium">
        <a href="/#about" class="mobile-nav-link py-1.5 hover:text-primary">About</a>
        <a href="/#services" class="mobile-nav-link py-1.5 hover:text-primary">Services & Pillars</a>
        <a href="/#industries" class="mobile-nav-link py-1.5 hover:text-primary">Industries We Serve</a>
        <a href="/projects" class="mobile-nav-link py-1.5 hover:text-primary">Project Gallery</a>
        <a href="/trades" class="mobile-nav-link py-1.5 hover:text-primary">Our Trades & Panels</a>
        <a href="/#contact" class="mobile-nav-link py-1.5 hover:text-primary">Contact & Location</a>
      </nav>
    </div>

    <div class="pt-4 border-t border-hairline">
      <div class="text-xs font-mono text-ink-muted mb-1.5">Direct Contact</div>
      <a href="tel:+971505077179" class="block font-mono font-semibold text-primary text-sm mb-1">+971 50 507 7179</a>
      <a href="tel:+97165431993" class="block font-mono font-semibold text-ink text-xs mb-3">+971 6 543 1993</a>
      <a href="#contact" class="w-full bg-primary text-canvas text-center font-semibold py-2.5 rounded-lg block text-sm">
        Request a Consultation
      </a>
    </div>
  </div>
</div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    if (mobileMenu) {
      mobileMenu.classList.toggle('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  navLinks.forEach(link => link.addEventListener('click', toggleMenu));
</script>
