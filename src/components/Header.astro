---
import { services } from '../data/services';
---
<header class="sticky top-0 z-50 transition-all duration-300 bg-cream/95 backdrop-blur-md border-b border-hairline px-4 sm:px-8 lg:px-12 h-16 sm:h-[72px] flex items-center justify-between">
  <!-- Brand Logo (Maximized within Fixed Header Height, High-Res Retina, No Edge Cutting) -->
  <div class="flex items-center h-full py-1.5 sm:py-2">
    <a href="/" aria-label="Al Sahra Tents & Sheds Fix" class="flex items-center h-full group">
      <img 
        src="/logo-retina.png" 
        alt="Al Sahra Tents & Sheds Fix" 
        width="894"
        height="432"
        class="h-full max-h-[50px] sm:max-h-[56px] w-auto object-contain [image-rendering:-webkit-optimize-contrast] transition-transform duration-300 group-hover:scale-105" 
      />
    </a>
  </div>
  
  <!-- Navigation Links with Mega-Menu for Services -->
  <nav class="hidden md:flex gap-6 lg:gap-8 items-center" id="desktop-nav">
    <a href="/about" class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors">
      About
    </a>

    <!-- Services Mega-Menu Trigger -->
    <div class="relative" id="services-dropdown">
      <button 
        type="button"
        class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors flex items-center gap-1 cursor-pointer"
        id="services-trigger"
        aria-expanded="false"
        aria-haspopup="true"
      >
        <span>Services</span>
        <svg class="w-3 h-3 transition-transform duration-200" id="services-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <!-- Mega-Menu Dropdown (3x3 Grid) -->
      <div 
        id="services-mega-menu"
        class="absolute top-full left-0 mt-3 w-[620px] bg-canvas rounded-2xl border border-hairline shadow-2xl shadow-black/10 p-5 opacity-0 invisible translate-y-2 transition-all duration-300 z-50"
      >
        <!-- Arrow pointer -->
        <div class="absolute -top-2 left-8 w-4 h-4 rotate-45 bg-canvas border-l border-t border-hairline"></div>

        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
            <span class="font-mono text-[10px] text-primary uppercase tracking-wider font-bold">9 Specialized Divisions</span>
            <a href="/#services" class="text-[11px] font-semibold text-gold-accent hover:text-primary transition-colors">View all →</a>
          </div>

          <div class="grid grid-cols-3 gap-2">
            {services.map(category => (
              <a 
                href={`/services/${category.slug}`}
                class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-sand transition-colors group"
              >
                <img 
                  src={category.heroImage} 
                  alt={category.name}
                  class="w-10 h-10 rounded-lg object-cover shrink-0 border border-hairline"
                  loading="lazy"
                />
                <div class="min-w-0">
                  <span class="font-body font-semibold text-[12px] text-ink group-hover:text-primary transition-colors leading-tight block truncate">
                    {category.name}
                  </span>
                  <span class="font-mono text-[9px] text-ink-muted">{category.subItems.length} solutions</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <a href="/about#industries" class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors">
      Industries
    </a>
    <a href="/projects" class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors">
      Projects
    </a>
    <a href="/trades" class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors">
      Our Trades
    </a>
    <a href="/contact" class="header-nav-link text-ink font-body font-medium text-[13.5px] lg:text-[14.5px] hover:text-primary transition-colors">
      Contact
    </a>
  </nav>

  <!-- Right Actions -->
  <div class="flex items-center gap-3 sm:gap-4">
    <!-- CTA Button (Proportional Size Matching Medium Logo) -->
    <a 
      href="/contact" 
      class="btn-live-header btn-shimmer font-body font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-lg sm:rounded-xl flex items-center gap-1.5"
    >
      <span class="relative z-10">Get Free Quote</span>
      <svg class="w-3.5 h-3.5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      class="md:hidden p-1.5 rounded-lg text-ink hover:bg-sand transition-colors"
      aria-label="Toggle Navigation Menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-navy-darker/70 backdrop-blur-sm hidden md:hidden">
  <div class="bg-cream w-4/5 max-w-sm h-full p-6 shadow-2xl flex flex-col justify-between overflow-y-auto">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-hairline">
        <img src="/logo-retina.png" alt="Al Sahra" class="h-10 w-auto object-contain [image-rendering:-webkit-optimize-contrast]" />
        <button id="close-menu-btn" class="p-2 text-ink" aria-label="Close Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="flex flex-col gap-1 py-6 font-body text-base text-ink font-medium">
        <a href="/about" class="mobile-nav-link py-2 hover:text-primary">About Us</a>
        
        <!-- Mobile Services Expandable -->
        <button 
          type="button"
          id="mobile-services-toggle"
          class="flex items-center justify-between py-2 hover:text-primary transition-colors w-full text-left font-medium"
        >
          <span>Services</span>
          <svg class="w-4 h-4 transition-transform duration-200" id="mobile-services-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div id="mobile-services-list" class="hidden pl-4 pb-2 space-y-1 border-l-2 border-primary/20 ml-1">
          {services.map(category => (
            <a 
              href={`/services/${category.slug}`}
              class="mobile-nav-link block py-1.5 text-sm text-ink-soft hover:text-primary transition-colors"
            >
              {category.name}
            </a>
          ))}
        </div>

        <a href="/about#industries" class="mobile-nav-link py-2 hover:text-primary">Industries We Serve</a>
        <a href="/projects" class="mobile-nav-link py-2 hover:text-primary">Project Gallery</a>
        <a href="/trades" class="mobile-nav-link py-2 hover:text-primary">Our Trades</a>
        <a href="/contact" class="mobile-nav-link py-2 hover:text-primary">Contact & Location</a>
      </nav>
    </div>

    <div class="pt-4 border-t border-hairline">
      <div class="text-xs font-mono text-ink-muted mb-1.5">Direct Contact</div>
      <a href="tel:+971505077179" class="block font-mono font-semibold text-primary text-sm mb-1">+971 50 507 7179</a>
      <a href="tel:+97165431993" class="block font-mono font-semibold text-ink text-xs mb-3">+971 6 543 1993</a>
      <a href="/contact" class="btn-live-header btn-shimmer w-full text-center font-semibold py-2.5 rounded-lg block text-sm">
        Request a Consultation
      </a>
    </div>
  </div>
</div>

<style>
  .header-nav-link {
    position: relative;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    transition: color 0.25s ease;
  }
  .header-nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 9999px;
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header-nav-link:hover::after,
  .header-nav-link:focus-visible::after,
  .header-nav-link.active-link::after {
    width: 100%;
  }
  .header-nav-link.active-link {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Mega-menu open state */
  #services-mega-menu.mega-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #services-chevron.chevron-open {
    transform: rotate(180deg);
  }
</style>

<script>
  // Desktop mega-menu
  const trigger = document.getElementById('services-trigger');
  const megaMenu = document.getElementById('services-mega-menu');
  const chevron = document.getElementById('services-chevron');
  const dropdown = document.getElementById('services-dropdown');

  let closeTimeout: ReturnType<typeof setTimeout>;

  function openMega() {
    clearTimeout(closeTimeout);
    megaMenu?.classList.add('mega-open');
    chevron?.classList.add('chevron-open');
    trigger?.setAttribute('aria-expanded', 'true');
  }

  function closeMega() {
    closeTimeout = setTimeout(() => {
      megaMenu?.classList.remove('mega-open');
      chevron?.classList.remove('chevron-open');
      trigger?.setAttribute('aria-expanded', 'false');
    }, 150);
  }

  dropdown?.addEventListener('mouseenter', openMega);
  dropdown?.addEventListener('mouseleave', closeMega);
  trigger?.addEventListener('click', () => {
    if (megaMenu?.classList.contains('mega-open')) {
      closeMega();
    } else {
      openMega();
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMega();
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('.mobile-nav-link');
  const headerLinks = document.querySelectorAll('.header-nav-link');

  function toggleMenu() {
    if (mobileMenu) {
      mobileMenu.classList.toggle('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  navLinks.forEach(link => link.addEventListener('click', toggleMenu));

  // Mobile services expandable
  const mobileServicesToggle = document.getElementById('mobile-services-toggle');
  const mobileServicesList = document.getElementById('mobile-services-list');
  const mobileServicesChevron = document.getElementById('mobile-services-chevron');

  mobileServicesToggle?.addEventListener('click', () => {
    mobileServicesList?.classList.toggle('hidden');
    mobileServicesChevron?.classList.toggle('chevron-open');
  });

  // Sync active underline selection on click and page load
  function syncActiveLink() {
    const hash = window.location.hash;
    const path = window.location.pathname;

    headerLinks.forEach(link => {
      const href = link.getAttribute('href') || '';
      if (hash && href.includes(hash)) {
        link.classList.add('active-link');
      } else if (!hash && (href === path || (path !== '/' && href.startsWith(path)))) {
        link.classList.add('active-link');
      } else {
        link.classList.remove('active-link');
      }
    });

    // Also highlight the Services trigger button if on a services page
    if (path.startsWith('/services')) {
      trigger?.classList.add('active-link');
    }
  }

  headerLinks.forEach(link => {
    link.addEventListener('click', () => {
      headerLinks.forEach(l => l.classList.remove('active-link'));
      link.classList.add('active-link');
    });
  });

  window.addEventListener('hashchange', syncActiveLink);
  document.addEventListener('DOMContentLoaded', syncActiveLink);
  syncActiveLink();
</script>
