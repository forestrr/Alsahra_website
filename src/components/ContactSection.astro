---
import ContactForm from './ContactForm';
---
<section id="contact" class="bg-navy-canvas py-[80px] px-6 md:px-16">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
    <div>
      <span class="font-mono text-primary text-xs uppercase tracking-[1px] block mb-4">Contact</span>
      <h2 class="font-display text-[44px] leading-tight tracking-[-0.4px] text-canvas mb-6">
        Let's talk about your project
      </h2>
      <p class="font-body text-ink-secondary text-lg mb-12 max-w-md">
        Send us your requirements and we'll come back with a quote — usually within 24 hours.
      </p>
      
      <div class="grid gap-8">
        <div>
          <h4 class="font-body font-medium text-sm text-ink-muted uppercase tracking-wider mb-2">Call Us</h4>
          <a href="tel:+971500000000" class="font-body text-canvas text-xl hover:text-primary transition-colors">+971 50 000 0000</a>
        </div>
        <div>
          <h4 class="font-body font-medium text-sm text-ink-muted uppercase tracking-wider mb-2">Email Us</h4>
          <a href="mailto:info@alsahragroup.com" class="font-body text-canvas text-xl hover:text-primary transition-colors">info@alsahragroup.com</a>
        </div>
        <div>
          <h4 class="font-body font-medium text-sm text-ink-muted uppercase tracking-wider mb-2">Visit Us</h4>
          <p class="font-body text-canvas text-xl">Sharjah, UAE</p>
        </div>
      </div>
    </div>
    
    <div class="relative">
      <!-- Decorator element behind the form -->
      <div class="absolute -inset-4 bg-navy-darker rounded-[24px] border border-navy-mid -z-10 hidden md:block"></div>
      <ContactForm client:visible />
    </div>
  </div>
</section>
