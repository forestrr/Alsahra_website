---
import ContactForm from './ContactForm';
---
<section id="contact" class="relative w-full min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
  
  <!-- Full Bleed Map Background -->
  <div class="absolute inset-0 z-0 bg-navy-darker">
    <!-- Overlay to darken and tint the map to match brand -->
    <div class="absolute inset-0 bg-navy-darker/80 mix-blend-multiply z-10 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-darker via-navy-darker/60 to-transparent z-10 pointer-events-none"></div>
    
    <iframe 
      title="Al Sahra Tents & Sheds - Haji Sultan Location"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7219.871288138115!2d55.94837667815705!3d25.205392720868858!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ef5a5e6617bfa29%3A0x4c1b9dcfb000fabb!2sAl%20Sahra%20Tents%20%26%20Sheds%20-%20Haji%20Sultan!5e0!3m2!1sen!2sae!4v1790150496356!5m2!1sen!2sae" 
      class="w-full h-[120%] -mt-[10%] border-0 filter grayscale contrast-125 opacity-40"
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>

  <!-- Monolithic Glassmorphic Dossier -->
  <div class="max-w-7xl w-full mx-auto px-6 sm:px-10 lg:px-16 relative z-20" data-reveal="fade-up">
    
    <div class="bg-navy-darker/80 backdrop-blur-2xl rounded-[32px] overflow-hidden border border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)]">
      <div class="grid lg:grid-cols-12">
        
        <!-- Left Column: Contact Details -->
        <div class="lg:col-span-5 p-8 sm:p-12 border-b lg:border-b-0 lg:border-r border-white/10 bg-gradient-to-br from-white/5 to-transparent relative">
          <!-- Decorative Glow -->
          <div class="absolute top-0 left-0 w-full h-full bg-gold-accent/5 blur-[100px] pointer-events-none"></div>

          <span class="font-mono text-gold-accent text-xs uppercase tracking-[0.2em] font-semibold block mb-4">
            Official UAE Consultation
          </span>
          <h2 class="font-display font-black text-3xl sm:text-4xl text-canvas tracking-tight mb-6">
            Get in touch with our engineers.
          </h2>
          <p class="font-body text-ink-secondary text-base leading-relaxed mb-12">
            Direct manufacturer consultation, structural engineering guidance, and formal quotation for tensile structures, car parking shades, and steel works.
          </p>
          
          <div class="space-y-8">
            <!-- Facility -->
            <div>
              <h4 class="font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-2">Workshop & Fabrication Yard</h4>
              <p class="font-body font-semibold text-canvas text-base mb-1">Sharjah Al Dhaid, United Arab Emirates</p>
              <div class="flex items-center gap-2 font-body text-xs text-ink-secondary">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Open Mon-Sat: 8:00 AM - 7:00 PM
              </div>
            </div>

            <!-- Phone -->
            <div>
              <h4 class="font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-2">Direct Call & WhatsApp</h4>
              <div class="flex flex-col gap-1 font-mono text-lg">
                <a href="tel:+971505077179" class="text-canvas font-semibold hover:text-gold-accent transition-colors flex items-center gap-3">
                  +971 50 507 7179
                  <span class="text-[10px] bg-white/10 px-2 py-0.5 rounded-full text-white">Primary</span>
                </a>
                <a href="tel:+97165610988" class="text-ink-secondary hover:text-gold-accent transition-colors text-base">
                  +971 (06) 561 0988
                </a>
              </div>
            </div>

            <!-- Web & Email -->
            <div>
              <h4 class="font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-2">Digital Enquiries</h4>
              <div class="flex flex-col gap-1 font-mono text-sm">
                <a href="mailto:info@alsahratents.ae" class="text-canvas font-semibold hover:text-gold-accent transition-colors">
                  info@alsahratents.ae
                </a>
                <a href="https://www.alsahratents.ae" target="_blank" class="text-ink-secondary hover:text-canvas transition-colors">
                  www.alsahratents.ae
                </a>
              </div>
            </div>

            <!-- Clickable Map Card -->
            <div>
              <h4 class="font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-3">Find Us on Google Maps</h4>
              <a 
                href="https://maps.app.goo.gl/51FhEVUjHWT2vKmE6"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block w-full rounded-2xl overflow-hidden border border-white/10 hover:border-gold-accent/40 transition-all duration-300 shadow-lg"
                aria-label="Open Al Sahra Tents location in Google Maps"
              >
                <iframe 
                  title="Al Sahra Tents Map"
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7219.871288138115!2d55.94837667815705!3d25.205392720868858!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ef5a5e6617bfa29%3A0x4c1b9dcfb000fabb!2sAl%20Sahra%20Tents%20%26%20Sheds%20-%20Haji%20Sultan!5e0!3m2!1sen!2sae!4v1790150496356!5m2!1sen!2sae"
                  class="w-full h-44 border-0 pointer-events-none filter grayscale"
                  loading="lazy"
                ></iframe>
                <!-- Clickable Overlay -->
                <div class="absolute inset-0 bg-navy-darker/50 group-hover:bg-navy-darker/20 transition-all duration-300 flex items-center justify-center">
                  <span class="inline-flex items-center gap-2 bg-gold-accent text-navy-darker font-mono font-bold text-xs uppercase tracking-wider px-4 py-2.5 rounded-full shadow-lg group-hover:scale-105 transition-transform duration-300">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    Open in Google Maps
                  </span>
                </div>
              </a>
            </div>
          </div>
        </div>
        
        <!-- Right Column: Interactive Form -->
        <div class="lg:col-span-7 p-8 sm:p-12 bg-navy-card/40 relative">
          <ContactForm client:visible />
        </div>
        
      </div>
    </div>
    
  </div>
</section>
