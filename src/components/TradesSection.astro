---
import { tradeProducts } from '../data/services';
---
<section id="trades" class="bg-navy-darker py-24 px-6 sm:px-10 lg:px-16 relative overflow-hidden border-t border-navy-mid">
  <!-- Subtle gradient background -->
  <div class="absolute top-0 right-0 w-full lg:w-1/2 h-full bg-gradient-to-l from-navy-card/50 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16 items-start">
      
      <!-- Left Column (Sticky Header) -->
      <div class="lg:col-span-5 mb-16 lg:mb-0 lg:sticky lg:top-32" data-reveal="fade-up">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="w-12 h-[1px] bg-gold-accent"></span>
          <span class="font-mono text-gold-accent text-xs uppercase tracking-[0.2em] font-semibold">
            Trading & Material Supply
          </span>
        </div>
        
        <h2 class="font-display font-black text-4xl sm:text-5xl lg:text-[52px] leading-[1.1] text-canvas tracking-tight mb-8">
          Architectural Panels & Profile Sheets.
        </h2>
        
        <p class="font-body text-ink-secondary text-lg leading-relaxed mb-10 pl-6 border-l-2 border-white/10">
          Supplying high-grade PPGI & Aluminum insulated flat panels, roofing panels, and profiled cladding sheets across UAE projects with guaranteed specifications and rapid local fulfillment direct from our Sharjah facility.
        </p>

        <!-- Trade Inquiry Banner (Integrated into Sticky Column) -->
        <div class="bg-navy-card/80 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/10 shadow-2xl">
          <h4 class="font-display font-semibold text-xl text-canvas mb-3">Looking for custom panel cuts?</h4>
          <p class="font-body text-sm text-ink-secondary mb-6 leading-relaxed">
            We supply standard and custom dimensions with prompt delivery for contractors across all UAE emirates.
          </p>
          <a 
            href="#contact" 
            class="inline-flex items-center justify-center w-full bg-gold-accent hover:bg-gold-glow text-navy-darker font-body font-bold text-sm px-6 py-4 rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(212,175,55,0.2)] hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]"
          >
            Inquire Bulk Supply
          </a>
        </div>
      </div>

      <!-- Right Column (Vertical Scrolling Trade Cards) -->
      <div class="lg:col-span-7 flex flex-col gap-10 sm:gap-16">
        {tradeProducts.map((trade, idx) => (
          <div 
            class="group bg-navy-card rounded-[32px] overflow-hidden border border-white/5 hover:border-gold-accent/30 transition-colors duration-500 shadow-2xl"
            data-reveal="fade-up"
            data-reveal-delay={String(idx * 0.1)}
          >
            <!-- Massive Image View -->
            <div class="relative aspect-[16/10] bg-black overflow-hidden">
              <img 
                src={trade.image} 
                alt={trade.name} 
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-card via-navy-card/40 to-transparent"></div>
              
              <div class="absolute top-6 left-6 flex items-center gap-2">
                <span class="font-mono text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-full bg-gold-accent text-navy-darker font-bold">
                  {trade.material}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-full bg-navy-darker/80 backdrop-blur-md text-canvas border border-white/10">
                  In Stock Sharjah
                </span>
              </div>
            </div>

            <!-- Detailed Content -->
            <div class="p-8 md:p-10 -mt-20 relative z-10">
              <h3 class="font-display font-bold text-3xl md:text-4xl text-canvas mb-4 group-hover:text-gold-accent transition-colors">
                {trade.name}
              </h3>
              <p class="font-body text-ink-secondary text-base leading-relaxed mb-8 max-w-xl">
                {trade.description}
              </p>

              <div class="grid sm:grid-cols-2 gap-6 mb-8">
                <!-- Specs -->
                <div class="bg-navy-darker p-5 rounded-2xl border border-white/5 space-y-3">
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-2">Technical Specs</span>
                  <div class="flex justify-between items-center text-sm font-mono border-b border-white/5 pb-2">
                    <span class="text-ink-secondary">Thickness</span>
                    <span class="text-gold-accent font-semibold">{trade.thickness}</span>
                  </div>
                  <div class="flex justify-between items-center text-sm font-mono">
                    <span class="text-ink-secondary">Dimensions</span>
                    <span class="text-canvas">{trade.dimensions}</span>
                  </div>
                </div>

                <!-- Applications -->
                <div class="bg-navy-darker p-5 rounded-2xl border border-white/5">
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-3">Ideal Applications</span>
                  <ul class="space-y-2.5">
                    {trade.applications.map(app => (
                      <li class="text-xs font-body text-ink-secondary flex items-start gap-2.5">
                        <span class="w-1.5 h-1.5 rounded-sm bg-primary shrink-0 mt-1"></span>
                        <span class="leading-snug">{app}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>
