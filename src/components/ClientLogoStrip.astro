---
import { clients } from '../data/clients';
---

<!-- ========================================================================= -->
<!-- THIN SINGLE-LINE CUSTOMER LOGO MARQUEE STRIP -->
<!-- ========================================================================= -->
<div class="bg-sand-soft/70 py-4 sm:py-5 overflow-hidden border-b border-hairline relative" aria-label="Client References">
  <!-- Gradient Edge Fade Masks for Seamless In/Out -->
  <div class="absolute left-0 inset-y-0 w-16 sm:w-28 bg-gradient-to-r from-sand-soft to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 inset-y-0 w-16 sm:w-28 bg-gradient-to-l from-sand-soft to-transparent z-10 pointer-events-none"></div>

  <!-- Single Continuous Sliding Line -->
  <div class="relative w-full overflow-hidden flex items-center">
    <div class="animate-marquee flex items-center gap-10 sm:gap-16 shrink-0 py-1">
      {clients.concat(clients).map((client) => (
        <div 
          class="flex items-center justify-center shrink-0 group transition-transform duration-300 hover:scale-105 px-2"
          title={client.name}
        >
          <img 
            src={client.logoSrc} 
            alt={client.name} 
            class="h-7 sm:h-8 max-w-[120px] sm:max-w-[140px] w-auto object-contain opacity-65 group-hover:opacity-100 transition-all duration-300 filter grayscale group-hover:grayscale-0"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</div>
